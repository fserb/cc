#!/bin/bash
set -euo pipefail
IFS=$'\n\t'

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

# deno test needs --ext js: `ccx` and `cchost` have no extension, so anything that
# reads them types them as TypeScript.
# The tests' temp dirs and files go in one dir per run, removed after: they never removed
# their own, and 2,874 ccx-chat-* dirs filled nadya's /tmp quota (2026-10-12).
test() {
  TEST_TMP=$(mktemp -d "${TMPDIR:-/tmp}/ccx-test.XXXXXX")
  trap 'command rm -rf "$TEST_TMP"' EXIT
  TMPDIR=$TEST_TMP deno test -A --ext js "$ROOT"/ccx/*_test.js "$ROOT"/host/*_test.js "$@"
}

check() {
  deno check "$ROOT"/host/*.js
}

# cchost, the daemon every machine with claudes runs: launchd on macOS, a
# systemd user unit on Linux. PATH has to reach deno, tmux and ps, which neither
# gives a job by default.
HOST_LABEL=net.fserb.cchost
OLD_LABEL=net.fserb.ccx-host
HOST_PLIST="$HOME/Library/LaunchAgents/$HOST_LABEL.plist"
HOST_UNIT="$HOME/.config/systemd/user/cchost.service"
OLD_UNIT="$HOME/.config/systemd/user/ccx-host.service"
HOST_PATH="$(dirname "$(command -v deno)"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

install() {
  _drop_old
  _ask_hook
  if [[ $(uname) == Darwin ]]; then
    mkdir -p "$(dirname "$HOST_PLIST")"
    local old=""
    [[ -f "$HOST_PLIST" ]] && old=$(cat "$HOST_PLIST")
    cat > "$HOST_PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by \`./task install\`. Edit ./task and reinstall, not this file. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$HOST_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$ROOT/host/cchost</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$HOST_PATH</string>
		<key>HOME</key>
		<string>$HOME</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$HOME/Library/Logs/cchost.log</string>
	<key>StandardErrorPath</key>
	<string>$HOME/Library/Logs/cchost.log</string>
</dict>
</plist>
PLISTEOF
    # bootout returns before the service is gone, and a bootstrap then fails with
    # "Bootstrap failed: 5: Input/output error" (2026-10-13), so wait it out; an
    # unchanged plist only needs a kickstart
    if [[ "$old" == "$(cat "$HOST_PLIST")" ]] && launchctl print "gui/$(id -u)/$HOST_LABEL" >/dev/null 2>&1; then
      launchctl kickstart -k "gui/$(id -u)/$HOST_LABEL"
    else
      _bootout "$HOST_LABEL"
      launchctl bootstrap "gui/$(id -u)" "$HOST_PLIST"
    fi
    _answers
    echo "$HOST_LABEL running from $HOST_PLIST"
  else
    mkdir -p "$(dirname "$HOST_UNIT")"
    cat > "$HOST_UNIT" <<UNITEOF
# Written by \`./task install\`. Edit ./task and reinstall, not this file.
[Unit]
Description=cchost

[Service]
ExecStart=$ROOT/host/cchost
Environment=PATH=$HOST_PATH
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
UNITEOF
    systemctl --user daemon-reload
    systemctl --user enable --now cchost.service
    systemctl --user restart cchost.service
    _answers
    echo "cchost.service running from $HOST_UNIT"
  fi
}

uninstall() {
  _drop_old
  if [[ $(uname) == Darwin ]]; then
    _bootout "$HOST_LABEL"
    rm -f "$HOST_PLIST"
  else
    systemctl --user disable --now cchost.service 2>/dev/null || true
    rm -f "$HOST_UNIT"
    systemctl --user daemon-reload
  fi
  echo "cchost removed"
}

# the daemon was `ccx host` under net.fserb.ccx-host / ccx-host.service until 2026-10-12
# askhook.sh as a PreToolUse hook on AskUserQuestion in ~/.claude/settings.json, once: it
# keeps a question's whole text for cchost while the dialog is up (host/askhook.sh)
_ask_hook() {
  ROOT="$ROOT" deno eval '
    const p = `${Deno.env.get("HOME")}/.claude/settings.json`;
    const s = JSON.parse(Deno.readTextFileSync(p));
    const pre = ((s.hooks ??= {}).PreToolUse ??= []);
    if (pre.some((h) => h.matcher === "AskUserQuestion")) Deno.exit(0);
    pre.push({matcher: "AskUserQuestion", hooks: [{type: "command", command: `${Deno.env.get("ROOT")}/host/askhook.sh`}]});
    Deno.writeTextFileSync(p, JSON.stringify(s, null, 2) + "\n");
    console.log(`added the AskUserQuestion hook to ${p}`);'
}

_drop_old() {
  if [[ $(uname) == Darwin ]]; then
    _bootout "$OLD_LABEL"
    rm -f "$HOME/Library/LaunchAgents/$OLD_LABEL.plist"
  elif [[ -f "$OLD_UNIT" ]]; then
    systemctl --user disable --now ccx-host.service 2>/dev/null || true
    rm -f "$OLD_UNIT"
    systemctl --user daemon-reload
  fi
}

# bootout, then wait until launchd no longer knows the label (10s at most)
_bootout() {
  local svc="gui/$(id -u)/$1"
  launchctl print "$svc" >/dev/null 2>&1 || return 0
  launchctl bootout "$svc" 2>/dev/null || true
  for _ in $(seq 50); do
    launchctl print "$svc" >/dev/null 2>&1 || return 0
    sleep 0.2
  done
  echo "$1 still loaded 10s after bootout" >&2
  return 1
}

# fail unless cchost answers on 7681 within 30s: a kickstart took 6-10s on marx
_answers() {
  for _ in $(seq 150); do
    curl -sf -o /dev/null --max-time 2 http://127.0.0.1:7681/api/list && return 0
    sleep 0.2
  done
  echo "cchost does not answer on 127.0.0.1:7681 30s after the restart" >&2
  return 1
}

function help {
  echo "$0 <task>   # everything else is ccx/ccx or host/cchost"
  compgen -A function | grep -v "^_" | cat -n
}

"${@:-help}"
