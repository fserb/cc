#!/bin/sh
':' //; exec deno run -A --ext js "$(readlink -f "$0")" "$@"
// cchost: the daemon every machine with claudes runs, what cc reads the machine through.
// The server on this host's tailnet addresses and loopback (--listen names others), and a
// stand-in record for every claude on the other hosts so SendMessage reaches them. The polyglot head is
// ccx's: sh re-execs deno on the realpath, so a symlink on PATH works.
//
//   cchost [serve] [--port N] [--listen addr,addr]
//
// --listen: the addresses to listen on, e.g. 127.0.0.1 on engels, which tailcat forwards to.
// Default: this host's tailnet addresses (100.x, fd7a:...), 127.0.0.1 and ::1, and every
// 30s any tailnet address that came since (tailscale up after cchost, a new tailnet). Was
// 0.0.0.0 until Oct 24th (user)

import {discover, StateClock, watchSessions} from "./claudes.js";
import {Online} from "./online.js";
import {PORT, runServer, tailnetAddrs} from "./server.js";
import {Goals} from "./goals.js";
import {Typed} from "./typed.js";
import {clearStandIns, Relay} from "./relay.js";
import * as remote from "./remote.js";
import {Subs} from "./subs.js";
import {HOME} from "./sh.js";
import {sendPeer} from "./peer.js";
import {settle} from "./burn.js";
import {Changes} from "./changes.js";
import {Away} from "./away.js";
import {pusher} from "./waitpush.js";
import {parseLinks, Tailcat} from "./tailcat.js";

function usage() {
  console.error("usage: cchost [serve] [--port N] [--listen addr,addr]");
  Deno.exit(2);
}

async function serve(args) {
  let port, listen;
  for (let n = 0; n < args.length; n++) {
    if (args[n] === "--port" && /^\d+$/.test(args[n + 1] ?? "")) port = Number(args[++n]);
    else if (args[n] === "--listen" && args[n + 1]) listen = args[++n].split(",").map((a) => a.trim()).filter((a) => a);
    else usage();
  }
  port ??= PORT;
  const clock = new StateClock(remote.SELF), net = new Online();
  // A poll runs when a session record is written, and otherwise once a minute for titles
  // and tmux moves, which no record shows. A write during a poll runs one more after it.
  // With no watch, or an instance with no record (its state is read off the pane), every
  // 1.5s as before. Also every 1.5s while a subagent runs: one stopping writes no record
  const goals = new Goals();
  let instances = [], polling = false, again = false, timer = 0, server = null;
  // api/changes: the clock's events of each poll, read with the goals set. Null until the
  // first poll is done, so the sessions running at a start are not `new`
  let changes = null;
  const pending = [];
  const poll = async () => {
    if (polling) {
      again = true;
      return;
    }
    polling = true;
    try {
      do {
        again = false;
        instances = clock.update(await discover());
      } while (again);
      for (const i of instances) i.goal = goals.get(i.pid);
      goals.prune(instances.map((i) => i.pid));
      goals.remember(instances);
      changes?.update(pending.splice(0), instances);
      server?.tick().catch((e) => console.error(e));
    } finally {
      polling = false;
      clearTimeout(timer);
      timer = setTimeout(repoll, !watching || instances.some((i) => !i.peer || i.agents) ? 1500 : 60000);
    }
  };
  // a failed poll keeps the instances it had, and says when
  const repoll = () => poll().catch((e) => console.error(`${new Date().toISOString()} poll: ${e?.message ?? e}`));
  const watching = watchSessions(repoll);
  setInterval(() => net.tick(), 5000);
  net.tick();
  // the burn store takes each hour as it settles, so api/burn seldom scans more than the
  // hour in progress; an empty store fills from transcripts here, ~15 days of them
  const settleNow = () => settle().catch((e) => console.error(`burn store: ${e.message}`));
  setInterval(settleNow, 10 * 60_000);
  settleNow();
  // a notice goes to a local subscriber's socket, or to its host's daemon. The listener runs
  // inside clock.update(), so `instances` is still the poll before, which is fine: a
  // subscriber had to exist to subscribe
  const subs = new Subs(remote.SELF, async (who, text) => {
    if (who.host !== remote.SELF) {
      return (await remote.call(who.host, `/api/s/${who.pid}/send`, {text, from: "ccx"}))[1];
    }
    const inst = instances.find((i) => i.pid === who.pid);
    return inst ? await sendPeer(inst, text, "ccx") : `no claude instance with pid ${who.pid}`;
  }, undefined, `${HOME}/.claude/ccx-subs.json`);
  clock.on((events) => subs.onEvents(events));
  await repoll();
  subs.load(instances.map((i) => i.pid));
  changes = new Changes(remote.SELF);
  changes.update([], instances);
  clock.on((events) => pending.push(...events));
  clearStandIns(remote.SELF);
  const relay = new Relay(remote.SELF, async (host, body) =>
    (await remote.call(host, "/api/relay", body))[1]);
  const away = new Away();
  const listening = listen ?? ["127.0.0.1", ...(hasV6Loopback() ? ["::1"] : []), ...tailnetAddrs()];
  const r = runServer({source: () => ({instances, net}), port, hostnames: listening, relay,
    subs, goals, typed: new Typed(), changes, away});
  if (r.error) {
    console.error(`cchost: ${r.error}`);
    Deno.exit(1);
  }
  server = r.server;
  // the tailcat links of CCX_TAILCAT (tailcat.js), their state in api/list
  const tailcat = new Tailcat(parseLinks(Deno.env.get("CCX_TAILCAT")), remote.isDown);
  if (tailcat.links.length) {
    server.tailcat = tailcat;
    tailcat.start();
  }
  if (!listen) setInterval(() => {
    for (const a of tailnetAddrs()) {
      if (listening.includes(a)) continue;
      const error = r.listen(a);
      if (error) console.error(`cchost: ${error}`);
      else listening.push(a);
    }
  }, 30_000);
  // away mode: a question box left DELAY is answered (away.js); a look every 10s
  setInterval(() => away.check(instances, (pid) => server.draft(pid)).catch((e) => console.error(`away: ${e.message}`)), 10_000);
  // a session waiting on the user for 2 min: one push to the phone (waitpush.js), on nadya
  const waitPush = pusher(() => server.mergedBody());
  let pushing = false;
  if (waitPush) setInterval(() => {
    if (pushing) return;
    pushing = true;
    waitPush().catch((e) => console.error(`waitpush: ${e.message}`)).finally(() => pushing = false);
  }, 15_000);
  // each other host's list stream feeds the relay's stand-ins and the merged list
  // (api/list?all=1) both
  const stops = remote.others().map((h) => remote.follow(h, (rows, body, why) => {
    relay.sync(h, rows);
    server.peer(h, body, why);
  }));
  stops.push(...remote.others().map((h) => remote.followChanges(h, changes)));
  const quit = () => {
    for (const stop of stops) stop();
    tailcat.stop();
    relay.close();
    Deno.exit(0);
  };
  Deno.addSignalListener("SIGINT", quit);
  Deno.addSignalListener("SIGTERM", quit);
  console.log(`cchost ${remote.SELF} on ${listening.map((a) => a.includes(":") ? `[${a}]` : a).join(", ")} :${port}, following ${remote.others().join(", ") ||
    "no other host"}`);
  await new Promise(() => {});
}

// ::1 only where the machine has it, or its listen fails and takes cchost down with it
function hasV6Loopback() {
  return Deno.networkInterfaces().some((i) => i.address === "::1");
}

// no arguments: CCHOST_ARGS, which the unit and plist pass from ~/.config/cchost.env
const given = Deno.args.length ? Deno.args : (Deno.env.get("CCHOST_ARGS") ?? "").split(/\s+/).filter((a) => a);
const args = given[0] === "serve" ? given.slice(1) : given;
await serve(args);
