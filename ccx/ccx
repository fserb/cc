#!/bin/sh
':' //; exec deno run -A --ext js "$(readlink -f "$0")" "$@"
// Two lines, two languages. sh runs line 2 and never reaches line 3; deno strips the
// hashbang and reads line 2 as a string then a comment. The re-exec is what makes a symlink
// on PATH work: deno resolves a relative import against the path it was handed, so
// ~/bin/ccx -> here looks for view.js in ~/bin and dies.
//
// ccx reads nothing of the machine: every row, message and action is a call to this
// host's cchost, which answers for every host (api/list?all=1, api/s/<host>.<pid>/...).
// Focusing a window is the exception, since it acts on the terminal you sit at: jump.js
// here for this host's sessions, a kitty window running `ssh <host> tmux attach` for
// another's. What is imported from host/ besides is pure: the order, the colours, the
// usage line, the notify parser.

import {fmtAge} from "../host/claudes.js";
import {HOME, ON_EXIT, sh} from "../host/sh.js";
import {fuzzy, NUMBERS, PALETTE, rank, SORTS, stateOf} from "../host/view.js";
import {attachSession, jump, kittyWindowTitle, raiseTarget, tmuxWindowName,
  withClient} from "../host/jump.js";
import {byDay, HISTORY, paceTable, usageLine, USAGE} from "../host/usage.js";
import {parseNotify} from "../host/subs.js";

// render

const ESC = "\x1b";
const RESET = `${ESC}[0m`;
const BOLD = `${ESC}[1m`;
// built, not a literal: an ESC byte inside a regex literal trips deno lint's no-control-regex
const SGR = new RegExp(`${ESC}\\[[0-9;]*m`, "g");

function sgr(hex, layer) {
  const n = Number.parseInt(hex.slice(1), 16);
  return `${ESC}[${layer};2;${(n >> 16) & 255};${(n >> 8) & 255};${n & 255}m`;
}

// every run opens with a reset, so nothing leaks out of the run before it
function paint(runs, back, bold = false) {
  let out = "";
  for (const r of runs) {
    if (!r.t) continue;
    out += RESET + (back ? sgr(back, 48) : "") + (r.c ? sgr(r.c, 38) : "") +
      (r.b || bold ? BOLD : "") + r.t;
  }
  return out + RESET;
}

// display cells, which String.length is not, so widths walk grapheme clusters. The state
// glyphs (● ◐ ◌ ◆) are East Asian *Ambiguous* and kitty draws ambiguous narrow.
const GRAPHEMES = new Intl.Segmenter(undefined, {granularity: "grapheme"});
const ZERO = /^[\p{Mn}\p{Me}\p{Cf}]/u;
const WIDE = /^[\u1100-\u115f\u2329\u232a\u2e80-\u303e\u3041-\u33ff\u3400-\u4dbf\u4e00-\u9fff\ua000-\ua4cf\uac00-\ud7a3\uf900-\ufaff\ufe10-\ufe19\ufe30-\ufe6f\uff00-\uff60\uffe0-\uffe6]/u;

function cell(grapheme) {
  if (ZERO.test(grapheme)) return 0;
  // emoji presentation is two cells: U+FE0F asks for it, U+1F300 and up already have it
  if (grapheme.includes("\ufe0f") || grapheme.codePointAt(0) >= 0x1f300) return 2;
  return WIDE.test(grapheme) ? 2 : 1;
}

const cells = (s) => [...GRAPHEMES.segment(s)].reduce((n, g) => n + cell(g.segment), 0);
const span = (runs) => runs.reduce((n, r) => n + cells(r.t), 0);

// stops on the cell budget, so a two-cell character that does not fit leaves a space
function fit(runs, width) {
  const out = [];
  let n = 0;
  outer:
  for (const r of runs) {
    let t = "";
    for (const g of GRAPHEMES.segment(r.t)) {
      const w = cell(g.segment);
      if (n + w > width) {
        if (t) out.push({...r, t});
        break outer;
      }
      t += g.segment;
      n += w;
    }
    if (t) out.push({...r, t});
  }
  if (n < width) out.push({t: " ".repeat(width - n)});
  return out;
}

// the head of `text` that fits in `width` cells, and the rest. fit() pads and takes runs;
// this one is for wrapping a body, where the tail is the next line rather than dropped
function cut(text, width) {
  let head = "", n = 0;
  for (const g of GRAPHEMES.segment(text)) {
    const w = cell(g.segment);
    if (n + w > width) break;
    head += g.segment;
    n += w;
  }
  return [head, text.slice(head.length)];
}

// Greedy word wrap on display cells. A word longer than the line is cut rather than left to
// run past the edge: a path or a URL has no space in it to break on.
function wrap(text, width) {
  if (width < 2) return [text];
  const out = [];
  let line = "";
  for (const word of text.split(" ")) {
    if (!line) line = word;
    else if (cells(line) + 1 + cells(word) <= width) line += ` ${word}`;
    else {
      out.push(line);
      line = word;
    }
    while (cells(line) > width) {
      const [head, rest] = cut(line, width);
      out.push(head);
      line = rest;
    }
  }
  out.push(line);
  return out;
}

// number, state, for, path; the summary takes the rest
const WIDTHS = [1, 6, 5, 26];
const HEADS = ["", "state", "for", "path", "summary"];
const FIXED = WIDTHS.reduce((a, w) => a + w + 2, 0);

function layout(cols) {
  const inner = Math.max(FIXED + 3, cols - 2);      // one column of margin on each side
  const widths = [...WIDTHS, inner - FIXED - 2];
  const xs = [];
  let x = 1;
  for (const w of widths) {
    xs.push(x);
    x += w + 2;
  }
  return {widths, xs, inner};
}

function tableLine(fields, lay, cols, back, bold = false) {
  const runs = [];
  fields.forEach((f, n) => runs.push({t: " "}, ...fit(f, lay.widths[n]), {t: " "}));
  return margins(fit(runs, tableWidth(lay, cols)), cols, back, bold);
}

// narrower than its columns crops, or the line runs past the edge and scrolls the frame
const tableWidth = (lay, cols) => Math.max(0, Math.min(lay.inner, cols - 1));

function margins(body, cols, back, bold = false) {
  return paint([{t: " "}], PALETTE.bg) + paint(body, back, bold) +
    paint([{t: " ".repeat(Math.max(0, cols - 1 - span(body)))}], PALETTE.bg);
}

function marks(text, color, needle) {
  if (!needle) return [{t: text, c: color}];
  const hit = fuzzy(needle, text);
  if (!hit) return [{t: text, c: color}];
  // fuzzy()'s indices are UTF-16, so walk code points and carry the offset, or a surrogate
  // pair splits across two runs with an SGR sequence through the middle
  const on = new Set(hit.idx);
  const runs = [];
  let i = 0;
  for (const ch of text) {
    const b = on.has(i);
    const last = runs.at(-1);
    if (last && !!last.b === b) last.t += ch;
    else runs.push({t: ch, c: b ? PALETTE.accent : color, b});
    i += ch.length;
  }
  return runs;
}

const KEY = (t) => ({t, c: PALETTE.accent, b: true});
const KEYS = [KEY("1-0"), {t: "/", c: PALETTE.text}, KEY("enter"),
  {t: " jump   ", c: PALETTE.text}, KEY("esc"), {t: " quit   ", c: PALETTE.text},
  KEY("^s"), {t: " sort   ", c: PALETTE.text}, KEY("^t"), {t: " chat", c: PALETTE.text}];

function barLine(view, cols) {
  const search = view.filter
    ? [{t: `/${view.filter}`, c: PALETTE.accent}]
    : [{t: "type to filter", c: PALETTE.hint}];
  const count = view.filter
    ? `${view.ranked.length} of ${view.total}`
    : `${view.waiting}/${view.total}`;
  const loud = view.waiting > 0 && !view.filter;
  const off = view.offline
    ? [{t: `${view.offline}  ·  `, c: PALETTE.error, b: true}] : [];
  const status = [...off, {t: count, c: loud ? PALETTE.gold : PALETTE.mauve, b: loud},
    {t: `  ·  by ${view.sort}`, c: PALETTE.mauve}];
  // hints go first on a narrow screen: the counts are the only place waiting is written
  const room = cols - span(status) - 4;
  const keys = room - span(KEYS) - 2 >= 16 ? [{t: " "}, ...KEYS, {t: " "}] : [];
  const left = Math.max(0, room - span(keys) - 1);
  return paint(fit([{t: " "}, ...fit(search, left), {t: "  "}, ...status, {t: "  "},
    ...keys], cols), PALETTE.bar);
}

function ruleLine(cols) {
  return paint([{t: "─".repeat(cols), c: PALETTE.edge}], PALETTE.bg);
}

function headerLine(lay, cols) {
  return tableLine(HEADS.map((h) => [{t: h, c: PALETTE.mauve, b: true}]), lay, cols,
    PALETTE.bg);
}

function rowLine(inst, n, cursor, lay, cols, needle) {
  const state = stateOf(inst);
  return tableLine([
    [{t: n < NUMBERS.length ? NUMBERS[n] : " ", c: PALETTE.dim}],
    [{t: state.label, c: state.color}],
    [{t: inst.age, c: PALETTE.dim}],
    marks(inst.shortPath, PALETTE.mauve, needle),
    marks(inst.summary, inst.state === "wait" ? PALETTE.text : PALETTE.idle, needle),
  ], lay, cols, cursor ? PALETTE.cursor : PALETTE.bg, cursor);
}

function noteLine(text, lay, cols) {
  return margins(fit([{t: " ".repeat(lay.xs[1])}, {t: text, c: PALETTE.hint}],
    tableWidth(lay, cols)), cols, PALETTE.bg);
}

function toastLine(text, cols) {
  const body = fit([{t: ` ${text} `, c: PALETTE.error}],
    Math.min(Math.max(0, cols - 1), cells(text) + 2));
  const gap = Math.max(0, cols - 1 - span(body));
  return paint([{t: " ".repeat(gap)}], PALETTE.bg) + paint(body, PALETTE.bar) +
    paint([{t: " "}], PALETTE.bg);
}

function capacity(height, total) {
  const room = Math.max(1, height - 3);
  return total > room ? Math.max(1, room - 1) : room;
}

function usageRow(usage, cols) {
  const body = fit([{t: usage.text, c: usage.color}],
    Math.min(Math.max(0, cols - 2), cells(usage.text)));
  return paint([{t: " ".repeat(Math.max(0, cols - 1 - span(body)))}], PALETTE.bg) +
    paint(body, PALETTE.bg) + paint([{t: " "}], PALETTE.bg);
}

// the usage line takes the bottom row and the table everything above it, "N more" included
function render(view) {
  const {cols} = view;
  const height = view.usage ? Math.max(0, view.height - 1) : view.height;
  const lay = layout(cols);
  const lines = [barLine(view, cols), ruleLine(cols), headerLine(lay, cols)];
  const room = capacity(height, view.ranked.length);
  const shown = view.ranked.slice(view.offset, view.offset + room);
  if (!view.ranked.length) {
    lines.push(noteLine(view.note || (view.total ? "nothing matches that filter"
      : "no claude instances"), lay, cols));
  }
  shown.forEach((inst, n) => lines.push(rowLine(inst, view.offset + n,
    view.offset + n === view.cursor, lay, cols, view.needle)));
  const blank = paint([{t: " ".repeat(cols)}], PALETTE.bg);
  while (lines.length < height) lines.push(blank);
  lines.length = height;                       // a screen too short crops from the bottom
  const hidden = view.ranked.length - shown.length;
  if (hidden > 0) lines[height - 1] = noteLine(`${hidden} more`, lay, cols);
  if (view.usage) lines.push(usageRow(view.usage, cols));
  if (view.toast) lines[lines.length - 1] = toastLine(view.toast, cols);
  return lines;
}

// the chat view

// What the agents in this directory said to each other. `chat.js` reads it, this draws it.

const CHAT_INDENT = 6;          // past the age column, so a body lines up under itself

/* One message as painted lines: a header of age, sender and recipient, then the body
 * wrapped under it.
 *
 * The body WRAPS rather than truncating. A message here runs to 2KB, and one cut to a
 * single line is a notification, while `chat` exists to read what was said; `ccx list` is
 * already the one-line view. The age is relative and not a clock time, since the question a
 * log answers is how long ago, and a clock time leaves the reader doing the arithmetic. The
 * cost is that a printed line keeps the age it had when it was printed, which is what
 * scrollback is anyway.
 */
function chatLines(msg, width, now) {
  const head = [
    {t: fmtAge(now - msg.at).padStart(4), c: PALETTE.dim},
    {t: "  "},
    {t: msg.from, c: PALETTE.accent, b: true},
  ];
  // → is East Asian Ambiguous, so kitty draws it in one cell, like the state glyphs
  if (msg.to) head.push({t: " → ", c: PALETTE.dim}, {t: msg.to, c: PALETTE.mauve});
  const out = [head];
  for (const para of msg.body.split("\n")) {
    for (const text of wrap(para, Math.max(8, width - CHAT_INDENT))) {
      out.push([{t: " ".repeat(CHAT_INDENT)}, {t: text, c: PALETTE.text}]);
    }
  }
  return out;
}

function chatRows(msgs, cols, now) {
  const out = [];
  msgs.forEach((m, n) => {
    if (n) out.push([]);                       // one blank line between messages
    out.push(...chatLines(m, Math.max(20, cols - 2), now));
  });
  return out;
}

const CHAT_WRAP = {msgs: null, cols: 0, count: -1, tick: 0, rows: []};

// The wrapped conversation, rebuilt when the width, the count or the second moves. A held
// arrow delivers eight scrolls in one read and each one needs the line count to clamp
// against; the second is in the key because the ages are drawn into the rows.
function chatBody(msgs, cols, now) {
  const tick = Math.floor(now);
  const w = CHAT_WRAP;
  if (w.msgs !== msgs || w.cols !== cols || w.count !== msgs.length || w.tick !== tick) {
    Object.assign(w, {msgs, cols, count: msgs.length, tick, rows: chatRows(msgs, cols, now)});
  }
  return w.rows;
}

function chatBar(cwd, count, cols) {
  const keys = [KEY("^t"), {t: " list   ", c: PALETTE.text}, KEY("esc"),
    {t: " quit", c: PALETTE.text}];
  const left = [{t: "chat  ", c: PALETTE.mauve, b: true}, {t: cwd, c: PALETTE.accent}];
  const status = [{t: `${count} msg`, c: PALETTE.mauve}];
  const room = cols - span(status) - 4;
  const shown = room - span(keys) - 2 >= 12 ? [{t: " "}, ...keys, {t: " "}] : [];
  const gap = Math.max(0, room - span(shown) - 1);
  return paint(fit([{t: " "}, ...fit(left, gap), {t: "  "}, ...status, {t: "  "}, ...shown],
    cols), PALETTE.bar);
}

function chatRender(view) {
  const {cols, height, msgs, now} = view;
  const rows = chatBody(msgs, cols, now);
  const room = Math.max(1, height - 2);
  const start = Math.max(0, Math.min(view.offset, rows.length - room));
  const lines = [chatBar(view.cwd, msgs.length, cols), ruleLine(cols)];
  if (!rows.length) lines.push(noteLine("nothing has been said in here yet", layout(cols), cols));
  for (const runs of rows.slice(start, start + room)) {
    lines.push(margins(fit(runs, Math.max(0, cols - 1)), cols, PALETTE.bg));
  }
  const blank = paint([{t: " ".repeat(cols)}], PALETTE.bg);
  while (lines.length < height) lines.push(blank);
  lines.length = height;
  if (view.toast) lines[height - 1] = toastLine(view.toast, cols);
  return lines;
}

// cchost

const API = (Deno.env.get("CCX_API") ?? "http://127.0.0.1:7681").replace(/\/+$/, "");
const API_NAME = API.replace(/^https?:\/\//, "");
const DOWN = (why) => `cchost not answering on ${API_NAME}: ${why}`;
// "Connection refused (os error 111)" out of fetch's "fetch failed" and its cause
const why = (e) => (e.cause?.message ?? e.message).split(": ").at(-1);

// GET, or POST `body` as JSON: [body, null, status], or [null, error, status]. Status 0 is
// no answer at all, a refused connection or a timeout
async function request(path, body = undefined, timeout = 5000) {
  const init = {signal: AbortSignal.timeout(timeout)};
  if (body !== undefined) {
    Object.assign(init, {method: "POST", body: JSON.stringify(body),
      headers: {"content-type": "application/json"}});
  }
  let r;
  try {
    r = await fetch(`${API}${path}`, init);
  } catch (e) {
    return [null, e.name === "TimeoutError" ? `no answer in ${timeout / 1000}s` : why(e), 0];
  }
  const j = await r.json().catch(() => ({}));
  if (r.ok) return [j, null, r.status];
  // a route this cchost does not have is older code, not a missing instance
  const old = r.status === 404 && j.error === "not found";
  return [null, old ? `cchost on ${API_NAME} has no ${path.split("?")[0]}; restart it on ` +
    "newer code" : j.error ?? `HTTP ${r.status}`, r.status];
}

// request(), where cchost not answering at all ends the command with one line, exit 1. A
// timeout on a call that answers slowly (spawn, close, burn) is that call's error instead
async function api(path, body = undefined, timeout = 5000) {
  const got = await request(path, body, timeout);
  if (got[2] === 0 && !got[1].startsWith("no answer")) {
    console.error(`ccx: ${DOWN(got[1])}`);
    Deno.exit(1);
  }
  return got;
}

// Every SSE frame of a response body as onFrame(event, data). With no byte in `idle` ms
// the stream counts as dead and `ctl` is aborted: cchost writes a keepalive every 15s
async function frames(r, ctl, onFrame, idle = 40_000) {
  let buf = "", timer = 0;
  const arm = () => {
    clearTimeout(timer);
    timer = setTimeout(() => ctl.abort(), idle);
  };
  arm();
  try {
    for await (const chunk of r.body.pipeThrough(new TextDecoderStream())) {
      arm();
      buf += chunk;
      let cut;
      while ((cut = buf.indexOf("\n\n")) >= 0) {
        const frame = buf.slice(0, cut);
        buf = buf.slice(cut + 2);
        const event = frame.match(/^event: (.*)$/m)?.[1];
        const data = frame.match(/^data: (.*)$/m)?.[1];
        if (event && data) onFrame(event, JSON.parse(data));
      }
    }
  } finally {
    clearTimeout(timer);
  }
}

// GET an SSE route: the response, or throws with why
async function openStream(path, ctl) {
  let r;
  try {
    r = await fetch(`${API}${path}`, {signal: ctl.signal});
  } catch (e) {
    throw new Error(DOWN(why(e)));
  }
  if (r.ok) return r;
  const j = await r.json().catch(() => ({}));
  throw new Error(r.status === 404 && j.error === "not found"
    ? `cchost on ${API_NAME} has no ${path.split("?")[0]}; restart it on newer code`
    : j.error ?? `HTTP ${r.status}`);
}

// the listing

// this host, which the list writes without a `host:`; cchost's own answer replaces it
let SELF = Deno.env.get("CCX_SELF") ?? Deno.hostname().split(".")[0];
let HOSTS = [SELF];

// A row of api/list?all=1, its pid `<host>.<pid>`, pane `<host>/<pane>`, session and path
// `<host>:...`, untagged: `host` is "" for this host's and the name of any other
class Inst {
  constructor(r, self) {
    const id = String(r.pid), dot = id.lastIndexOf(".");
    const host = dot > 0 ? id.slice(0, dot) : self;
    const strip = (s, sep) => s?.startsWith(`${host}${sep}`) ? s.slice(host.length + 1) : s ?? "";
    Object.assign(this, {name: "", summary: "", asking: "", tab: "", since: 0}, r, {
      host: host === self ? "" : host, origin: host, pid: Number(id.slice(dot + 1)),
      path: strip(r.path, ":"), pane: strip(r.pane, "/"), session: strip(r.session, ":")});
  }

  get key() {
    return `${this.origin}:${this.pid}`;
  }

  // what api/s/<id>/... takes: a bare pid is this host's, as an older cchost has it
  get id() {
    return this.host ? `${this.host}.${this.pid}` : `${this.pid}`;
  }

  get shortPath() {
    const path = this.path || "?";
    const tabbed = this.tab ? `${path}:${this.name || this.tab}` : path;
    return this.host ? `${this.host}:${tabbed}` : tabbed;
  }

  get age() {
    return this.since ? fmtAge(Date.now() / 1000 - this.since) : "?";
  }
}

// An api/list?all=1 body as instances, this host's first, and SELF and HOSTS from it
function adopt(body) {
  SELF = body.self ?? SELF;
  HOSTS = body.hosts ?? [...new Set([SELF, ...(body.up ?? []),
    ...(body.down ?? []).map(([h]) => h)])];
  const all = (body.rows ?? []).map((r) => new Inst(r, SELF));
  return [...all.filter((i) => !i.host), ...all.filter((i) => i.host)];
}

// Every instance on every host, with the hosts that are down on stderr
async function listing() {
  const [body, err] = await api("/api/list?all=1");
  if (err) {
    console.error(`ccx: ${err}`);
    Deno.exit(1);
  }
  reportDown(body.down ?? []);
  return adopt(body);
}

// `host:name` for another host's instance, the name alone for this one's
const label = (i) => `${i.host ? `${i.host}:` : ""}${i.name || i.pid}`;

// Focus an instance: this host's by jump(), against its tmux client as it is now, another
// host's by selecting its pane there and raising a kitty window attached to its session.
// An error message, or null
async function focus(i) {
  if (!i.host) return await jump(await withClient(i));
  if (!i.pane) return `${label(i)} is not inside tmux; nothing to focus`;
  const [r, err] = await request(`/api/s/${i.id}/select`, {});
  if (err) return err;
  return await attachSession(i.host, i.session, r?.background);
}

// the tui

const CWD = Deno.cwd();
const SHORT_CWD = CWD.replace(HOME, "~");

const app = {
  usage: null,
  instances: [],
  down: "",              // why cchost's stream is not there, "" while it is
  offline: "",           // the API, and the hosts cchost cannot reach
  ranked: [],
  filter: "",
  sort: SORTS[0],
  cursorKey: null,
  cursor: 0,
  offset: 0,
  toast: null,
  fade: 0,
  chat: {on: false, msgs: [], offset: 0, pinned: true, stop: null},
};

const OUT = new TextEncoder();
const IN = new TextDecoder();
const write = (s) => Deno.stdout.writeSync(OUT.encode(s));

function size() {
  try {
    const {columns, rows} = Deno.consoleSize();
    return {cols: columns, height: rows};
  } catch {
    return {cols: 100, height: 24};            // no tty, which only --snapshot reaches
  }
}

// trimmed: a leading space is how to search for a digit, which in an empty filter picks a row
const needle = () => app.filter.trim().toLowerCase();

function view() {
  const {cols, height} = size();
  return {
    ranked: app.ranked,
    total: app.instances.length,
    waiting: app.instances.filter((i) => i.state === "wait").length,
    filter: app.filter,
    needle: needle(),
    sort: app.sort,
    offline: app.down ? "cchost down" : app.offline,
    note: app.down,
    usage: usageLine(app.usage),
    cursor: app.cursor,
    offset: app.offset,
    toast: app.toast,
    cols,
    height,
  };
}

// api/events?all=1, for as long as the app runs: a list on every change, and on a drop
// no rows and why, then again in 2s
async function followList() {
  while (true) {
    const ctl = new AbortController();
    let why = "stream ended";
    try {
      const r = await openStream("/api/events?all=1", ctl);
      await frames(r, ctl, (event, body) => {
        if (event !== "list") return;
        app.down = "";
        app.instances = adopt(body);
        app.offline = [body.offline, ...(body.down ?? []).map(([h]) => `${h} down`)]
          .filter(Boolean).join("  ·  ");
        refresh();
        draw();
      });
    } catch (e) {
      why = e.name === "AbortError" ? "no keepalive in 40s" : e.message;
    }
    app.down = why.startsWith("cchost") ? why : DOWN(why);
    app.instances = [];
    refresh();
    draw();
    await new Promise((ok) => setTimeout(ok, 2000));
  }
}

// cchost keeps the merged reading a minute, so asking more often gains nothing
async function followUsage() {
  const [body] = await request("/api/usage", undefined, 30_000);
  if (body) app.usage = body.usage;
  draw();
}

function refresh() {
  app.ranked = rank(app.instances, needle(), app.sort);
  const at = app.ranked.findIndex((i) => i.key === app.cursorKey);
  app.cursor = at >= 0 ? at : 0;
  app.cursorKey = app.ranked[app.cursor]?.key ?? null;
  const room = tableRoom();
  app.offset = Math.max(0, Math.min(app.offset, app.ranked.length - room, app.cursor));
  app.offset = Math.max(app.offset, app.cursor - room + 1);
}

function chatView() {
  const {cols, height} = size();
  return {cwd: SHORT_CWD, msgs: app.chat.msgs, offset: app.chat.offset, toast: app.toast,
    cols, height, now: Date.now() / 1000};
}

let drawing = false;      // set once the screen is ours; a frame before that is noise
function draw() {
  if (!drawing) return;
  const frame = app.chat.on ? chatRender(chatView()) : render(view());
  write(`${ESC}[H${frame.join("\r\n")}`);
}

const tableRoom = () =>
  capacity(size().height - (usageLine(app.usage) ? 1 : 0), app.ranked.length);
const chatRoom = () => Math.max(1, size().height - 2);

// the offset is a line and not a message: a 2KB body is taller than the screen, so a
// message is not a unit anything can page by
function scrollChat(delta) {
  const c = app.chat;
  const rows = chatBody(c.msgs, size().cols, Date.now() / 1000);
  const last = Math.max(0, rows.length - chatRoom());
  c.offset = Math.max(0, Math.min(last, c.offset + delta));
  c.pinned = c.offset >= last;
}

/* ctrl+t opens and closes the chat. tmux's prefix here is ctrl+b and ctrl+s is the sort, so
 * 0x14 is free; no modifier survives on a printable key, since tmux runs `extended-keys
 * off`, which is what rules out every plain letter.
 *
 * escape, ctrl+c and ctrl+q still leave the app from in here rather than backing out to the
 * list: they are the way out of ccx, and a key that means quit in one view and back in
 * another is worse than the one keystroke it saves.
 *
 * The conversation is cchost's api/chat/events?all=1 for this directory on every host: `log`
 * once, then `msg`, which a host that answered late can send older than the last one.
 */
async function toggleChat() {
  if (app.chat.on) return closeChat();
  const c = app.chat, ctl = new AbortController();
  let r;
  try {
    r = await openStream(`/api/chat/events?all=1&cwd=${encodeURIComponent(CWD)}`, ctl);
  } catch (e) {
    toast(`no chat here: ${e.message}`);
    return draw();
  }
  const stop = () => ctl.abort();
  Object.assign(c, {on: true, msgs: [], stop, offset: Number.MAX_SAFE_INTEGER});
  const pin = () => {
    if (c.pinned) c.offset = Number.MAX_SAFE_INTEGER;   // newest, which scrollChat clamps
    scrollChat(0);
    draw();
  };
  frames(r, ctl, (event, body) => {
    if (event === "log") c.msgs = body.msgs;
    else if (event === "msg") c.msgs = [...c.msgs, body].sort((a, b) => a.at - b.at);
    else return;
    pin();
  }).catch(() => {}).finally(() => {
    if (c.stop !== stop || !c.on) return;
    toast("chat: cchost's stream ended");
    draw();
  });
  scrollChat(0);
  draw();
}

function closeChat() {
  app.chat.stop?.();
  app.chat.stop = null;
  app.chat.on = false;
  draw();
}

// index as well as pid: one read carries eight arrows, refresh() reseats once at the end
function move(delta) {
  if (!app.ranked.length) return;
  app.cursor = Math.max(0, Math.min(app.ranked.length - 1, app.cursor + delta));
  app.cursorKey = app.ranked[app.cursor].key;
}

// not awaited: enter keeps the app up, so the jump runs while the TUI draws and toasts
async function jumpRow(n) {
  if (n < 0 || n >= app.ranked.length) return;
  app.cursor = n;
  app.cursorKey = app.ranked[n].key;
  const err = await focus(app.ranked[n]);
  if (err) {
    toast(err);
    draw();                                    // the draw for this keystroke already ran
  }
}

function toast(text) {
  app.toast = text;
  clearTimeout(app.fade);
  app.fade = setTimeout(() => {
    app.toast = null;
    draw();
  }, 2000);
}

function sortAt(col, lay) {
  const n = lay.xs.findIndex((x, i) => col >= x && col < x + lay.widths[i] + 2);
  if (SORTS.includes(HEADS[n])) app.sort = HEADS[n];
}

// reads the raw filter, not the needle, or a lone space strips to empty and picks a row
function typed(ch) {
  if (!app.filter && NUMBERS.includes(ch)) {
    jumpRow(NUMBERS.indexOf(ch));
    return;
  }
  app.filter += ch;
}

function mouse(body, final) {
  if (final !== "M") return;                   // a release; the press already acted
  const [b, x, y] = body.slice(1).split(";").map(Number);
  if (b & 64) return app.chat.on ? scrollChat(b & 1 ? 3 : -3) : move(b & 1 ? 1 : -1);
  if (app.chat.on) return;                     // no rows to click on
  if ((b & 3) !== 0) return;                   // not the left button
  const lay = layout(size().cols);
  if (y - 1 === 2) return sortAt(x - 1, lay);  // the header row
  // a single click jumps, without closing. Past `room` is the "N more" line, drawn where a
  // row would be, whose index names a row that is not on the screen
  const row = y - 4;
  if (row >= 0 && row < tableRoom()) jumpRow(app.offset + row);
}

function csi(body, final) {
  if (body.startsWith("<")) return mouse(body, final);
  const key = body + final;
  if (app.chat.on) {
    if (key === "A") return scrollChat(-1);
    if (key === "B") return scrollChat(1);
    if (key === "5~") return scrollChat(-chatRoom());
    if (key === "6~") return scrollChat(chatRoom());
    if (key === "H" || key === "1~") return scrollChat(-Number.MAX_SAFE_INTEGER);
    if (key === "F" || key === "4~") return scrollChat(Number.MAX_SAFE_INTEGER);
    return;
  }
  if (key === "A") return move(-1);
  if (key === "B") return move(1);
  if (key === "5~") return move(-tableRoom());
  if (key === "6~") return move(tableRoom());
  if (key === "H" || key === "1~") return move(-app.ranked.length);
  if (key === "F" || key === "4~") return move(app.ranked.length);
}

// a read of exactly one 0x1b is escape, no timer: a real sequence arrives in the same read
function handle(chunk) {
  if (chunk.length === 1 && chunk[0] === 0x1b) return quit();
  let i = 0;
  while (i < chunk.length) {
    const b = chunk[i];
    if (b === 0x1b && chunk[i + 1] === 0x5b) {                    // CSI
      let j = i + 2;
      while (j < chunk.length && chunk[j] >= 0x20 && chunk[j] <= 0x3f) j++;
      if (j >= chunk.length) break;   // a sequence split across two reads, rather than
      csi(IN.decode(chunk.subarray(i + 2, j)), String.fromCharCode(chunk[j]));
      i = j + 1;                      // its tail arriving in the filter as text
      continue;
    }
    if (b === 0x1b || b === 0x03 || b === 0x11) return quit();     // esc, ctrl+c, ctrl+q
    if (b === 0x14) {                                              // ctrl+t
      toggleChat();
      i++;
      continue;
    }
    // the chat view has no filter and no row under a cursor, so enter, backspace and every
    // printable key do nothing at all rather than act on a list that is not on the screen
    if (app.chat.on) {
      i++;
      continue;
    }
    if (b === 0x13) {                                              // ctrl+s
      app.sort = SORTS[(SORTS.indexOf(app.sort) + 1) % SORTS.length];
      i++;
      continue;
    }
    if (b === 0x0d || b === 0x0a) {
      jumpRow(app.cursor);
      i++;
      continue;
    }
    if (b === 0x7f || b === 0x08) {
      app.filter = app.filter.slice(0, -1);
      i++;
      continue;
    }
    if (b < 0x20) {
      i++;
      continue;
    }
    // a run of printable bytes, decoded together so a multi-byte character survives
    let j = i;
    while (j < chunk.length && chunk[j] >= 0x20 && chunk[j] !== 0x7f && chunk[j] !== 0x1b) j++;
    for (const ch of IN.decode(chunk.subarray(i, j))) typed(ch);
    i = j;
  }
}

// wrap off (?7l), or writing the last cell of the last row scrolls the frame
function enter() {
  Deno.stdin.setRaw(true);
  write(`${ESC}[?1049h${ESC}[?25l${ESC}[?7l${ESC}[?1000h${ESC}[?1006h${ESC}[2J`);
}

function leave() {
  write(`${ESC}[?1006l${ESC}[?1000l${ESC}[?7h${ESC}[?25h${ESC}[?1049l`);
  try {
    Deno.stdin.setRaw(false);
  } catch { /* stdin already gone, which is the SIGHUP path */ }
}

let restores = [];

// escape to gone in 2ms, 10ms for ctrl+c or ctrl+q, measured in a pty
function quit() {
  app.chat.stop?.();
  leave();
  for (const f of restores) f();
  for (const f of ON_EXIT) f();
  Deno.exit(0);
}

async function cmdUi() {
  // no tty: setRaw would throw
  if (!Deno.stdin.isTerminal()) {
    console.error("ccx ps is a terminal app: try `ccx list` or `ccx --snapshot`");
    Deno.exit(2);
  }
  restores = [tmuxWindowName("ccx"), await kittyWindowTitle("ccx")];
  enter();
  drawing = true;
  for (const sig of ["SIGTERM", "SIGHUP"]) Deno.addSignalListener(sig, quit);
  Deno.addSignalListener("SIGWINCH", () => {
    write(`${ESC}[2J`);              // a shrink leaves the old frame's tail on the screen
    refresh();
    draw();
  });
  followList();
  followUsage();
  setInterval(followUsage, 60_000);
  setInterval(draw, 1000);           // the ages; the rows come with the stream
  draw();
  const buf = new Uint8Array(4096);
  try {
    while (true) {
      const n = await Deno.stdin.read(buf);
      if (n === null) break;         // stdin closed under us
      handle(buf.subarray(0, n));
      refresh();
      draw();
    }
  } catch (e) {
    leave();                         // a traceback is unreadable on the alternate screen
    for (const f of ON_EXIT) f();
    throw e;
  }
  quit();
}

// snapshot

// fixed rows: a snapshot with a live discover() in it is not reproducible
const NOW = 1_700_000_000;
// the names are the record's own, which is what `ccx send` resolves a target against; two
// start with `ccx` on purpose, so a fuzzy target has something to be ambiguous about
const SAMPLE = [
  ["wait", 42, "~/ai/ccx", "port ccx from python to deno", "ccx-e8"],
  ["busy", 197, "~/prj/wrangler", "wrangler config for the edge worker", "wrangler-3a"],
  ["free", 8100, "~/web/blob2", "", "blob2-7c"],
  // a dialog is up, so this one draws ◆ rather than ●: same state, same sort
  ["wait", 7, "~/blah", "reorganize the skills tree", "blah-11",
    "edit ~/blah/skills/SKILLS.md"],
  ["busy", 1500, "~/ai/ccx:2", "inline the bell and play it from memory", "ccx-2f"],
  // two-cell characters: a width counted in code units misaligns this row's summary
  ["wait", 320, "~/prj/kanji", "日本語のタイトル in a session title", "kanji-90"],
  // over both crops, so the hard cut at 26 and 50 shows in a frame
  ["busy", 60, "~/prj/a-very-long-directory-name-that-does-not-fit",
    "a summary that is definitely longer than fifty display cells in total", "long-04"],
  // idle on another session, not on you
  ["hold", 900, "~/web/arcade", "PS2 blend modes, holding builds for a bench", "arcade-13"],
];
function sample() {
  // duck-typed: rank() and render() read shortPath, summary, state, since, pid, age,
  // asking; the resolver reads pid and name as well
  return SAMPLE.map(([state, ago, shortPath, summary, name, asking = ""], n) => ({
    pid: 1000 + n, state, summary, shortPath, name, asking, since: NOW - ago,
    age: ago < 60 ? `${ago}s`
      : ago < 3600 ? `${Math.floor(ago / 60)}m` : `${Math.floor(ago / 3600)}h`,
  }));
}

// A conversation with the shapes that break a renderer: a body under one line, one over it,
// a hard newline, a word longer than any terminal, and two-cell characters.
const CHAT_SAMPLE = [
  {at: NOW - 7400, from: "ccx-ef", to: "ccx-85", body: "you own ccx and ccx_test.js " +
    "outright from now until you hand them back. I am splitting claudes.js into five " +
    "files right now, so code against the final map rather than what is on disk.",
    msgId: "m1", sessionId: "s1"},
  {at: NOW - 3600, from: "ccx-85", to: "ccx-ef", body: "ack", msgId: "m2", sessionId: "s2"},
  {at: NOW - 900, from: "ccx-49", to: "all", body: "chat.js is in.\n" +
    "the log is ~/.claude/chat/-Users-fserb-ai-ccx.jsonl, one message per line.",
    msgId: "m3", sessionId: "s3"},
  {at: NOW - 30, from: "ccx-85", to: "ccx-49", body: "日本語のタイトル, and a path with " +
    "no break in it: /Users/fserb/ai/ccx/a-very-long-directory-name-that-does-not-fit-on-" +
    "one-line-at-all/deeper", msgId: "m4", sessionId: "s4"},
];

// ccx --snapshot [chat] [<cols>x<rows>] [plain] [/<filter>] [empty] [toast] [cursor=N]
//                 [offset=N] [usage=<used>@<hours into the week>]
// cursor= and offset= reach the cursor row's fill and a scrolled table; both are colour,
// so `plain` throws away what you came for. `chat` draws the chat view against CHAT_SAMPLE
// and an `at` fixed against NOW, since a relative age off the clock is not reproducible
function cmdSnapshot(...args) {
  let cols = 100, height = 14, plain = false, filter = "", rows = sample(), toast = null;
  let cursor = 0, offset = 0, chat = false, offline = "", use = null;
  for (const a of args) {
    const wh = /^(\d+)x(\d+)$/.exec(a);
    const nm = /^(cursor|offset)=(\d+)$/.exec(a);
    const us = /^usage=([\d.]+)@([\d.]+)$/.exec(a);
    if (wh) [cols, height] = [Number(wh[1]), Number(wh[2])];
    else if (us) {
      // reset times print in local time, so the frame is only fixed under a fixed TZ
      const now = NOW * 1000, left = (168 - Number(us[2])) * 3600_000;
      use = usageLine({used: Number(us[1]), resetsAt: now + left, at: now}, now);
    }
    else if (nm) (nm[1] === "cursor" ? cursor = Number(nm[2]) : offset = Number(nm[2]));
    else if (a === "plain") plain = true;
    else if (a === "chat") chat = true;
    else if (a === "empty") rows = [];
    else if (a === "offline") offline = "offline";
    else if (a === "toast") toast = "pid 1000 is not inside tmux; nothing to focus";
    else if (a.startsWith("/")) filter = a.slice(1);
    else return usage();
  }
  const needle = filter.trim().toLowerCase();
  const ranked = rank(rows, needle, SORTS[0]);
  const frame = (chat
    ? chatRender({cwd: "~/ai/ccx", msgs: rows.length ? CHAT_SAMPLE : [], offset, toast,
      cols, height, now: NOW})
    : render({
      ranked, total: rows.length, waiting: rows.filter((i) => i.state === "wait").length,
      filter, needle, sort: SORTS[0], offline, usage: use, cursor, offset, toast, cols, height,
    })).join("\n");
  console.log(plain ? frame.replaceAll(SGR, "") : frame);
}

// ccx --resolve <target>[,<target>...] [self=N]
// The resolver against --snapshot's fixed rows. `--ext js` covers the entry module only, so
// ccx_test.js cannot import this file; a subprocess is how the frame is tested too
function cmdResolve(...args) {
  let spec = "", self = 0;
  for (const a of args) {
    const s = /^self=(\d+)$/.exec(a);
    if (s) self = Number(s[1]);
    else if (!spec) spec = a;
    else return usage();
  }
  if (!spec) usage();
  const {found, missed} = resolveTargets(sample(), spec, self);
  for (const t of missed) console.log(`miss ${t}`);
  for (const i of found) console.log(`${i.pid} ${i.name} ${i.shortPath}`);
}


// cli

// a host that did not answer, on stderr so a pipe still carries only rows
function reportDown(down) {
  for (const [h, err] of down) console.error(`${h}: down, ${err}`);
}

// an error from cchost, on stderr, and exit 1
function fail(cmd, err) {
  console.error(`${cmd}: ${err}`);
  Deno.exit(1);
}

async function cmdList() {
  for (const i of await listing()) {
    console.log(`${stateOf(i).label.padEnd(6)} ${i.age.padStart(4)}  ` +
      `${(i.host ? `${i.host}:${i.pid}` : `${i.pid}`).padEnd(12)} ` +
      `${i.shortPath.replace(`${i.host}:`, "").padEnd(30)} ${i.summary}`);
  }
}

// ccx usage
// The seven-day line, the weighted tokens per 1% cchost measured and over what, the pace
// over each of the last 1h to 6h, then the week so far a local day per row, every host's
// log merged
async function cmdUsage() {
  const [body, err] = await api("/api/usage", undefined, 30_000);
  if (err) fail("usage", err);
  const u = body.usage, line = usageLine(u);
  if (!line) {
    console.log(u ? "the week in ccx-usage.json is over" : `${USAGE} missing or unreadable; ` +
      "statusLine in ~/.claude/settings.json writes it");
    return Deno.exit(1);
  }
  console.log(`${line.text}\n`);
  const t = u.paceTokens, when = (ms) => new Date(ms).toLocaleString("en-US",
    {weekday: "short", hour: "numeric", minute: "2-digit"});
  const c = t?.calib, upTo = c?.drop ? when(c.to) : "now";
  if (t) console.log(c ? `${(t.perPct / 1e6).toFixed(1)}M weighted tokens per 1%, measured ` +
    `${when(c.from)} to ${upTo}: ${(c.w / 1e6).toFixed(0)}M for +${Math.round(c.added)}%` +
    (c.drop ? `, from before the drop at ${when(c.drop)}: under 3% added since it` : "") + "\n"
    : `${(t.perPct / 1e6).toFixed(1)}M weighted tokens per 1%, the fixed fallback: ` +
      "the log added under 3% in the last 7 days\n");
  const table = paceTable(u);
  if (table.length) console.log(`${table.join("\n")}\n`);
  const days = byDay(u);
  days.forEach((d, i) => {
    const day = new Date(d.day).toLocaleDateString("en-US", {weekday: "short"});
    const note = i === days.length - 1 ? "  so far" : d.samples ? "" : "  interpolated";
    console.log(`${day}  ${`${Math.round(d.used)}%`.padStart(4)}  ` +
      `${`+${Math.round(d.added)}%`.padStart(4)}${note}`);
  });
}

// ccx burn [hours] [--top N] [--json]
// Who used the limit, every host's transcripts: with no hours, last week, this week and
// this week's days per project, as % of the limit; with hours, the last N per project and
// session with their tokens. cchost keeps the hourly store and merges the hosts
async function cmdBurn(...args) {
  let hours = 0, top = 12, raw = false;
  for (let n = 0; n < args.length; n++) {
    if (args[n] === "--json") raw = true;
    else if (args[n] === "--top" && Number(args[n + 1]) > 0) top = Number(args[++n]);
    else if (Number(args[n]) > 0) hours = Number(args[n]);
    else usage();
  }
  const [r, err] = await api(`/api/burn${hours ? `?hours=${hours}` : ""}`, undefined, 120_000);
  if (err) fail("burn", err);
  if (raw) return console.log(JSON.stringify(r));
  if (r.error) fail("burn", r.error);
  reportDown(r.down ?? []);
  const pct = (q) => q == null ? "" : `${q < 10 ? q.toFixed(1) : Math.round(q)}%`;
  const tok = (n) => n >= 1e9 ? `${(n / 1e9).toFixed(1)}G` : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M`
    : n >= 1e3 ? `${Math.round(n / 1e3)}k` : `${n}`;
  const when = (t) => new Date(t).toLocaleString("en-US", {weekday: "short", hour: "numeric",
    minute: "2-digit"});
  if (hours) {
    console.log(`burn ${hours}h (${when(r.from)} - ${when(r.to)}): ${tok(r.w)} weighted tok, ` +
      (r.used == null ? `~${pct(r.est)} of the week at ${tok(r.perPct ?? 3.5e6)}/% (no log for this window)`
        : `the log added ${pct(r.used)} of the week`));
    const row = (name, t) => console.log(`${(t.q == null ? `${pct(t.share)}*` : pct(t.q))
      .padStart(6)}  ${name.padEnd(22)} out ` +
      `${tok(t.out).padStart(5)}  cw ${tok(t.cw).padStart(5)}  cr ${tok(t.cr).padStart(6)}  ` +
      `${t.m} msgs`);
    console.log("== projects");
    for (const p of r.projects) row(p.p, p);
    console.log("== sessions");
    const ss = r.projects.flatMap((p) => p.sessions).sort((a, b) => b.w - a.w).slice(0, top);
    for (const s of ss) row(s.n, s);
    return;
  }
  // a column per window, a row per project, % of the limit; a window with no usage log
  // shows each one's share of its tokens instead, starred
  const cols = [...r.weeks, ...r.days.filter((d) => d.from >= r.weeks[1].from)];
  const names = r.weeks[1].projects.concat(r.weeks[0].projects).map((p) => p.p)
    .filter((p, n, a) => a.indexOf(p) === n).slice(0, top);
  const cell = (w, p) => {
    const x = w.projects.find((x) => x.p === p);
    return (w.used == null ? `${pct(x?.share ?? 0)}*` : pct(x?.q ?? 0)).padStart(7);
  };
  console.log(`${"".padEnd(18)}${["last", "this", ...cols.slice(2).map((d) => d.label)]
    .map((l) => l.padStart(7)).join("")}`);
  console.log(`${"used".padEnd(18)}${cols.map((w) => (w.used == null ? "?" : pct(w.used))
    .padStart(7)).join("")}`);
  for (const p of names) console.log(`${p.slice(0, 17).padEnd(18)}${cols.map((w) => cell(w, p)).join("")}`);
  if (cols.some((w) => w.used == null)) {
    console.log("* no usage log for that window: the share of its tokens, not of the limit");
  }
}

// What the terminal here has for focusing, then what cchost answers for: the API, the
// usage files, every host, and each of this host's instances with the kitty match a
// focus would use, which is read here since the focus runs here
async function cmdDoctor() {
  console.log(`TMUX=${Deno.env.get("TMUX") ?? "(none)"}  ` +
    `KITTY_WINDOW_ID=${Deno.env.get("KITTY_WINDOW_ID") ?? "(none)"}`);
  const pass = (await sh("tmux", "show", "-gv", "allow-passthrough")).trim();
  console.log(`tmux allow-passthrough: ${pass}`);
  console.log(`platform ${Deno.build.os}`);
  const at = performance.now();
  const [list, listErr, status] = await api("/api/list?all=1");
  if (listErr) fail("doctor", `cchost ${API_NAME}: ${listErr}`);
  const instances = adopt(list);
  console.log(`cchost ${API_NAME} up, HTTP ${status} in ${Math.round(performance.now() - at)}ms`);
  // one probe, from cchost: the endpoint it sees, and `from`, which file or var set it
  const [d, dErr] = await api("/api/doctor", undefined, 15_000);
  console.log(dErr ? `api (${dErr})` : `api ${d.api.url} (${d.api.from}) ` +
    `${d.api.ok ? "up" : "DOWN"} ${d.api.note} in ${Math.round(d.api.ms)}ms`);
  // what the status line last copied out on this host, and how old that copy is
  const [ub] = await api("/api/usage?local=1", undefined, 15_000);
  const u = ub?.usage;
  console.log(u
    ? `usage ${USAGE} written ${fmtAge((Date.now() - u.at) / 1000)} ago: 7d ` +
      `${u.used}% resets ${new Date(u.resetsAt).toISOString()}  ` +
      `${usageLine(u)?.text ?? "(week over)"}\n` +
      `usage ${HISTORY}: ${u.history.length} lines` +
      (u.history.length ? ` from ${new Date(u.history[0].at).toISOString()}` : "")
    : `usage ${USAGE} missing or unreadable; statusLine in ~/.claude/settings.json writes it`);
  console.log(`hosts ${HOSTS.join(", ")}, this one ${SELF}`);
  const down = new Map(list.down ?? []);
  for (const h of HOSTS) {
    console.log(down.has(h) ? `  ${h} DOWN: ${down.get(h)}`
      : `  ${h} up, ${instances.filter((i) => i.origin === h).length} rows`);
  }
  for (const row of instances.filter((i) => !i.host)) {
    const i = await withClient(row);
    console.log(`  pid ${i.pid} pane ${i.pane || "-"} session ${i.session || "-"} ` +
      `state ${i.state || "?"} record ${i.status ?? "(none)"}` +
      `${i.asking ? "/" + i.asking : ""} ` +
      `match ${i.match ?? "(unresolved)"} raise ${await raiseTarget(i)}`);
  }
}

// ccx focus <target>, one instance on any host
async function cmdFocus(spec) {
  const hits = resolveTarget(await listing(), spec, 0);
  if (hits.length !== 1) {
    console.error(hits.length ? `focus: ${JSON.stringify(spec)} names ${hits.length}: ` +
      hits.map(label).join(", ") : `focus: no instance matches ${JSON.stringify(spec)}`);
    Deno.exit(1);
  }
  const err = await focus(hits[0]);
  if (err) fail("focus", err);
}

// `host:pid` out of a tagged `host.pid`, and a bare pid as it is
const named = (pid) => String(pid).replace(/^([^.]+)\.(\d+)$/, "$1:$2");

// ccx new [--focus] [--goal <text>] [host:]<dir> [name]
// cchost's api/spawn, which cc's + calls too: a detached tmux session. --focus puts it in a
// new tmux window after an instance already in `dir`, else a new kitty window, and focuses
// it, on the host it runs on. --goal is what cc shows under its name
async function cmdNew(...args) {
  const focusIt = args.includes("--focus");
  const g = args.indexOf("--goal");
  const goal = g < 0 ? "" : args[g + 1] ?? "";
  if (g >= 0 && !goal.trim()) usage();
  const [dir, ...words] = args.filter((a, n) => a !== "--focus" && (g < 0 || n < g || n > g + 1));
  if (!dir) usage();
  const name = words.join(" ");
  await listing();                   // for HOSTS and SELF
  const [host, rest] = splitHost(dir);
  if (host) {
    // the remote's own ~ and realpath; a relative dir would mean ours
    if (!rest.startsWith("/") && !rest.startsWith("~")) {
      fail("new", `${host}: give an absolute or ~ path, not ${JSON.stringify(rest)}`);
    }
    // spawn() waits up to 5s for a window, 10s for claude and 10s for its trust dialog
    const [r, err] = await api("/api/spawn", {dir: `${host}:${rest}`, name, beside: true,
      focus: focusIt, goal}, 45_000);
    if (err) fail("new", `${host}: ${err}`);
    if (r.warning) console.error(`new: ${host}: ${r.warning}`);
    const pane = String(r.pane ?? "").replace(`${host}/`, "");
    console.log(r.existing ? `${named(r.pid)} already running in ${host}:${rest}`
      : `started ${named(r.pid)} in ${host}:${rest}, ` +
        (r.into ? `new tmux window after ${r.into}, pane ${pane}`
          : r.after ? `tmux window after ${r.after}` : focusIt ? `tmux pane ${pane}`
          : `detached tmux pane ${pane}`));
    return;
  }
  // relative to where ccx runs, which cchost does not know
  let path = rest === "~" || rest.startsWith("~/") ? `${HOME}${rest.slice(1)}` : rest;
  if (!path.startsWith("/")) path = `${CWD}/${path}`;
  try {
    path = Deno.realPathSync(path);
  } catch {
    // spawn() names the missing directory
  }
  const [r, err] = await api("/api/spawn", {dir: path, name, beside: true, focus: focusIt,
    goal}, 45_000);
  if (err) fail("new", err);
  if (r.warning) console.error(`new: ${r.warning}`);
  console.log(r.existing ? `${r.pid} already running in ${path.replace(HOME, "~")}`
    : `started ${r.pid} in ${path.replace(HOME, "~")}, ` +
      (r.into ? `new tmux window after ${r.into}, pane ${r.pane}`
        : r.after ? `tmux window after ${r.after}` : focusIt ? "new kitty window"
        : `detached tmux pane ${r.pane}`));
}

// ccx delete [host:]<name|pid>
// An exact name or pid, never the fuzzy match `send` takes, and one instance only: a typo
// that happens to match some other session would kill that one
async function cmdDelete(spec) {
  const i = await exactlyOne("delete", spec);
  report("closed", [i], [], [(await api(`/api/s/${i.id}/close`, {}, 20_000))[1]]);
}

async function exactlyOne(cmd, spec) {
  const instances = await listing();
  const [host, want] = splitHost(spec);
  const needle = want.toLowerCase();
  const hits = instances.filter((i) => i.host === host &&
    (String(i.pid) === want || i.name.toLowerCase() === needle));
  if (hits.length !== 1) {
    console.error(hits.length
      ? `${cmd}: ${JSON.stringify(spec)} names ${hits.length}: ${hits.map(label).join(", ")}`
      : `${cmd}: no instance is named ${JSON.stringify(spec)}`);
    Deno.exit(1);
  }
  return hits[0];
}

// ccx close [host:]<name|pid>
// delete, unless the user may be using it: cchost refuses unless it waits on its next prompt
// with no dialog, nothing typed in its pane and nothing in cc's box for it, read at the close.
// Refused inside a claude, a trig rule tells that claude to try again in RETRY_MIN
const RETRY_MIN = 5;
async function cmdClose(spec) {
  const i = await exactlyOne("close", spec);
  const [, err, status] = await api(`/api/s/${i.id}/close`, {ifUntouched: true}, 20_000);
  if (status !== 409 || !err.startsWith("not closed:")) {
    return report("closed", [i], [], [err]);
  }
  console.log(sendLine("refused", label(i), i.shortPath, err.replace("not closed: ", "")));
  if (!selfPid()) Deno.exit(1);
  const at = new Date(Date.now() + RETRY_MIN * 60e3);
  const hhmm = `${String(at.getHours()).padStart(2, "0")}:${String(at.getMinutes()).padStart(2, "0")}`;
  const why = err.replace("not closed: ", "");
  // its own background shells, Monitors or idle agents: not the user, so delete is the caller's call
  const after = why.startsWith("it has background work")
    ? "its own shells, Monitors or agents still run and may end by themselves. If its work is done " +
      `and committed and those are not needed, \`ccx delete ${spec}\` stops them with it; else run ` +
      `\`ccx close ${spec}\` again, which sets the next retry itself.\"`
    : `the user may be using it. Run \`ccx close ${spec}\` again; it checks again and, if refused, ` +
      "sets the next retry itself. Do not use ccx delete on it.\"";
  const rule = `at ${hhmm} -> me "ccx close ${spec} was refused (${why}): ${after}`;
  const r = await new Deno.Command("trig", {args: ["add", rule], stdout: "piped", stderr: "piped"})
    .output().catch((e) => ({success: false, stderr: new TextEncoder().encode(e.message)}));
  const dec = (b) => new TextDecoder().decode(b).trim();
  console.log(r.success ? `retry at ${hhmm}: trig rule ${dec(r.stdout)}`
    : `no retry set: trig add: ${dec(r.stderr)}`);
  Deno.exit(1);
}

// `host:rest` naming another host, as ["host", "rest"]; anything else is ours, ["", spec]
function splitHost(spec) {
  const colon = spec.indexOf(":");
  const host = colon > 0 ? spec.slice(0, colon) : "";
  if (!HOSTS.includes(host)) return ["", spec];
  return [host === SELF ? "" : host, spec.slice(colon + 1)];
}

// targets

// The instance we are running inside, or 0 outside one. Claude Code puts CLAUDE_PID in the
// environment of every shell it spawns (2.1.273, read off a live one), so `all` can leave
// us out for the price of an env read rather than a walk up the ppid chain.
function selfPid() {
  const pid = Number(Deno.env.get("CLAUDE_PID") ?? 0);
  return Number.isInteger(pid) && pid > 0 ? pid : 0;
}

/* One target: `all`, a pid, a name, or a fuzzy match on the name or the path.
 *
 * Exact beats fuzzy, so a session actually named `ccx` is not outranked by another whose
 * path merely holds those three letters. Matching more than one instance is the point of
 * the feature and not an error; matching none is the only error resolution has.
 */
function resolveTarget(instances, target, self = 0) {
  if (!target) return [];
  // `host:target` is target among that host's instances only
  const colon = target.indexOf(":");
  if (colon > 0 && HOSTS.includes(target.slice(0, colon))) {
    const host = target.slice(0, colon) === SELF ? "" : target.slice(0, colon);
    // a bare pid below means a local one, and a pid here is that host's
    const pid = target.slice(colon + 1);
    if (/^\d+$/.test(pid)) return instances.filter((i) => (i.host ?? "") === host && i.pid === Number(pid));
    return resolveTarget(instances.filter((i) => (i.host ?? "") === host), target.slice(colon + 1),
      self);
  }
  if (target === "all") return instances.filter((i) => i.host || i.pid !== self);
  if (/^\d+$/.test(target)) return instances.filter((i) => !i.host && i.pid === Number(target));
  const needle = target.toLowerCase();
  const named = instances.filter((i) => i.name.toLowerCase() === needle);
  if (named.length) return named;
  const scored = [];
  for (const i of instances) {
    const hits = [fuzzy(needle, i.name), fuzzy(needle, i.shortPath)].filter((h) => h);
    if (hits.length) scored.push([Math.min(...hits.map((h) => h.score)), i]);
  }
  return scored.sort((a, b) => a[0] - b[0] || a[1].pid - b[1].pid).map((p) => p[1]);
}

// Every target's matches, in the order the targets were written and each instance once: two
// targets that name the same session send it one message, not two.
function resolveTargets(instances, spec, self = 0) {
  const found = [], missed = [], seen = new Set();
  for (const t of spec.split(",").map((s) => s.trim()).filter((s) => s)) {
    const hits = resolveTarget(instances, t, self);
    if (!hits.length) missed.push(t);
    for (const i of hits) {
      if (seen.has(label(i))) continue;
      seen.add(label(i));
      found.push(i);
    }
  }
  return {found, missed};
}

// `ccx list`'s shape: what happened, who to, where, and the detail. String.padEnd and not
// display cells, like cmdList: a listing that is piped is columns, not a frame
const sendLine = (verb, who, where, what) =>
  `${verb.padEnd(6)} ${who.padEnd(12)} ${where.padEnd(30)} ${what}`;

// Validate, then resolve. In that order: a target is resolved against live state, so text
// that is not there has to be caught first or `ccx send ccx-ef` goes looking for ccx-ef.
// Exits on usage; returns what `spec` named and what it did not
async function targets(cmd, spec, text) {
  if (!spec || !text.trim()) usage();
  const rows = await listing();
  const {found, missed} = resolveTargets(rows, spec, selfPid());
  if (!found.length) {
    for (const t of missed) console.error(`${cmd}: no instance matches ${JSON.stringify(t)}`);
    usage();
  }
  return {found, missed, rows};
}

// One line per target in the order written, and exit 1 if any of them failed. The errs are
// awaited together: one target can fail while the others land, and a listing that arrives
// in completion order is unreadable
function report(verb, found, missed, errs) {
  for (const t of missed) console.log(sendLine("failed", t, "-", "no instance matches"));
  found.forEach((i, n) => console.log(errs[n]
    ? sendLine("failed", label(i), i.shortPath, errs[n])
    : sendLine(verb, label(i), i.shortPath, i.summary)));
  if (missed.length || errs.some((e) => e)) Deno.exit(1);
}

// ccx send <target>[,<target>...] <message...>
// cchost's api/s/<id>/send, from-name `user`
async function cmdSend(spec, ...words) {
  const text = words.join(" ");
  const {found, missed} = await targets("send", spec, text);
  report("sent", found, missed, await Promise.all(found.map(async (i) =>
    (await api(`/api/s/${i.id}/send`, {text}))[1])));
}

// ccx user [--force] [--as <who>] <target>[,<target>...] <text...>
// Typed into the instance's prompt as its own user and submitted, so `/clear` clears it;
// `send` puts a message from a peer on its queue, which no slash command survives. Refused
// on a pane showing a dialog, which the Enter would answer, unless --force. cchost notes
// who typed it, so cc does not draw it as the user's (typed.js): --as, else the session
// running ccx, else `ccx`
async function cmdUser(...args) {
  let force = false, as = "";
  for (;;) {
    if (args[0] === "--force") force = !!args.shift();
    else if (args[0] === "--as" && args[1]?.trim()) as = args.splice(0, 2)[1].trim();
    else break;
  }
  const [spec, ...words] = args;
  const text = words.join(" ");
  const {found, missed, rows} = await targets("user", spec, text);
  const self = selfPid();
  const by = as || (self && rows.find((i) => !i.host && i.pid === self)?.name) || "ccx";
  report("typed", found, missed, await Promise.all(found.map(async (i) =>
    (await api(`/api/s/${i.id}/type`, {text, force, by}, 10_000))[1])));
}

// ccx goal <target>[,<target>...] <text...>
// cchost's api/s/<id>/goal: what cc shows under its name, in place of Claude's summary
async function cmdGoal(spec, ...words) {
  const goal = words.join(" ");
  const {found, missed} = await targets("goal", spec, goal);
  report("set", found, missed, await Promise.all(found.map(async (i) =>
    (await api(`/api/s/${i.id}/goal`, {goal}))[1])));
}

// ccx post <url|path> [title...]
// Into cc's inbox (UPDATES): a mock or a report for the user to look at. Not cchost's: cc's web/api box on nadya keeps
// it (~/nadya/tmp/inbox.jsonl), so this is the one command that talks to something else. A path is made absolute and
// named on this host (`marx:~/web/x/mocks/a.html`; on nadya `~/nadya/` is left off, as the files tab names it)
async function cmdPost(where, ...words) {
  if (!where) usage();
  let url = where;
  if (!/^https?:\/\//.test(where)) {
    const home = Deno.env.get("HOME") ?? "";
    let p = where.startsWith("~/") ? where : where.startsWith("/") ? where : `${Deno.cwd()}/${where}`;
    p = p.replace(/\/\.\//g, "/");
    if (home && (p === home || p.startsWith(`${home}/`))) p = `~${p.slice(home.length)}`;
    url = SELF === "nadya" ? p.replace(/^~\/nadya\//, "") : `${SELF}:${p}`;
  }
  const self = selfPid();
  const by = (self && (await listing()).find((i) => !i.host && i.pid === self)?.name) || SELF;
  const inbox = Deno.env.get("CC_INBOX") ?? "https://nadya.gum.ts.net/cc/api/inbox";
  const r = await fetch(inbox, {method: "POST", body: JSON.stringify({url, title: words.join(" "), by}), signal: AbortSignal.timeout(10_000)})
    .catch((e) => ({ok: false, status: 0, text: () => e.message}));
  if (!r.ok) { console.error(`ccx: post: ${r.status} ${await r.text()}`); Deno.exit(1); }
  console.log(`posted ${url}`);
}

// ccx chat [--no-follow] [--here]
// What the agents in this directory said to each other, out of the transcripts of every
// host (the same path under each one's home) or with --here this host's: cchost's api/chat,
// or api/chat/events to follow
async function cmdChat(...args) {
  let follow = true, all = true;
  for (const a of args) {
    if (a === "--no-follow") follow = false;
    else if (a === "--here") all = false;
    else usage();
  }
  // colour only into a terminal, so a pipe carries the words and nothing else
  const colour = Deno.stdout.isTerminal();
  const width = Math.max(20, size().cols - 1);
  const show = (m) => {
    for (const runs of chatLines(m, width, Date.now() / 1000)) {
      console.log(colour ? paint(runs, null) : runs.map((r) => r.t).join("").trimEnd());
    }
    console.log("");
  };
  const q = `${all ? "all=1&" : ""}cwd=${encodeURIComponent(CWD)}`;
  const down = (body) => {
    for (const [h, why] of body.down ?? []) console.error(`${h}: down, ${why}`);
  };
  if (!follow) {
    const [body, err] = await api(`/api/chat?${q}`, undefined, 40_000);
    if (err) fail("chat", err);
    down(body);
    for (const m of body.msgs) show(m);
    return;
  }
  const ctl = new AbortController();
  let r;
  try {
    r = await openStream(`/api/chat/events?${q}`, ctl);
  } catch (e) {
    fail("chat", e.message);
  }
  // ctrl+c is the way out, the same as `tail -f`
  try {
    await frames(r, ctl, (event, body) => {
      if (event === "log") {
        down(body);
        for (const m of body.msgs) show(m);
      }
      else if (event === "msg") show(body);
    });
  } catch (e) {
    fail("chat", e.name === "AbortError" ? DOWN("no keepalive in 40s") : DOWN(e.message));
  }
  fail("chat", DOWN("the stream ended"));
}

// Exactly one instance for `spec`, `me` being the one we run inside; exits otherwise
function onlyOne(cmd, instances, spec) {
  const self = selfPid();
  const hits = spec === "me" ? instances.filter((i) => !i.host && i.pid === self)
    : resolveTarget(instances, spec, self);
  if (hits.length === 1) return hits[0];
  console.error(spec === "me" && !self ? `${cmd}: "me" only means something inside a claude`
    : hits.length ? `${cmd}: ${JSON.stringify(spec)} is ${hits.map(label).join(", ")}; name one`
    : `${cmd}: no instance matches ${JSON.stringify(spec)}`);
  Deno.exit(1);
}

const where = (i) => `${i.host || SELF}:${i.name || i.pid}`;

// ccx notify <who> when <agent> [is <state>] [for <duration>]
// Held by the daemon of the host <agent> runs on, which messages <who> from `ccx`; this
// host's cchost passes it there (api/subs with `host`)
async function cmdNotify(...words) {
  const n = parseNotify(words);
  if (n.error) {
    console.error(`notify: ${n.error}`);
    Deno.exit(2);
  }
  const instances = await listing();
  const who = onlyOne("notify", instances, n.who);
  if (n.state === "new") return notifyNew(n, who, words);
  const target = onlyOne("notify", instances, n.target);
  const host = target.host || SELF;
  const [r, err] = await api("/api/subs", {host, pid: target.pid, state: n.state,
    secs: n.secs, who: {host: who.host || SELF, pid: who.pid, name: who.name}}, 15_000);
  if (err) fail("notify", err);
  const what = n.state ? `is ${n.state}` : "changes state";
  const until = n.secs ? `, every time for ${words.at(-1)}` : ", once";
  const now = n.state && r.state === n.state ? `; it is ${r.state} already, so the next time`
    : `; now ${r.state}`;
  console.log(`${host}:${r.id}: tell ${where(who)} when ${where(target)} ${what}${until}${now}`);
}

// `any is new`: a copy with every host's daemon, or the one named, since each sees only
// its own sessions start
async function notifyNew(n, who, words) {
  const prefix = n.target.includes(":") ? n.target.split(":")[0] : "";
  if (prefix && !HOSTS.includes(prefix)) fail("notify", `no host ${JSON.stringify(prefix)}`);
  const hosts = prefix ? [prefix] : HOSTS;
  const until = n.secs ? `, every time for ${words.at(-1)}` : ", once per host";
  const body = {any: true, state: "new", secs: n.secs,
    who: {host: who.host || SELF, pid: who.pid, name: who.name}};
  const answers = await Promise.all(hosts.map((h) =>
    api("/api/subs", {...body, host: h}, 15_000)));
  let ok = 0;
  for (const [i, [r, err]] of answers.entries()) {
    const host = hosts[i];
    if (err) {
      console.error(`notify: ${host}: ${err}`);
      continue;
    }
    ok++;
    console.log(`${host}:${r.id}: tell ${where(who)} when a session starts on ${host}${until}`);
  }
  if (!ok) Deno.exit(1);
}

// "12:13 PM" today, "Sat Oct 17 12:13 PM" any other day
function untilText(epoch) {
  const d = new Date(epoch * 1000);
  const time = d.toLocaleTimeString([], {hour: "numeric", minute: "2-digit"});
  return d.toDateString() === new Date().toDateString() ? time
    : `${d.toDateString().slice(0, 10)} ${time}`;
}

// ccx subs: every host's subscriptions
async function cmdSubs() {
  await listing();                   // for HOSTS
  const all = await Promise.all(HOSTS.map((h) =>
    api(`/api/subs?host=${encodeURIComponent(h)}`, undefined, 15_000)));
  HOSTS.forEach((h, n) => {
    const [body, err] = all[n];
    if (err) return console.error(`${h}: down, ${err}`);
    for (const s of body.subs) {
      const until = s.until ? `until ${untilText(s.until)}` : "once";
      console.log(`${`${h}:${s.id}`.padEnd(10)} ${`${s.who.host}:${s.who.name || s.who.pid}`
        .padEnd(18)} <- ${`${h}:${s.target.any ? "any" : s.target.name || s.target.pid}`
        .padEnd(18)} ` +
        `${(s.state || "any").padEnd(5)} ${until}`);
    }
  });
}

// ccx unsub [host:]<id>, this host's id without one
async function cmdUnsub(spec) {
  const m = /^(?:([^:]+):)?(\d+)$/.exec(spec);
  if (!m) usage();
  await listing();                   // for HOSTS
  if (m[1] && !HOSTS.includes(m[1])) usage();
  const [, err] = await api("/api/unsub", {host: m[1] ?? SELF, id: Number(m[2])}, 15_000);
  if (err) fail("unsub", err);
}

const COMMANDS = {
  ps: [cmdUi, 0],
  list: [cmdList, 0],
  usage: [cmdUsage, 0],
  burn: [cmdBurn, -1],
  doctor: [cmdDoctor, 0],
  focus: [cmdFocus, 1],
  new: [cmdNew, -1],
  delete: [cmdDelete, 1],
  close: [cmdClose, 1],
  send: [cmdSend, -1],               // -1: its own validation, since the message is the rest
  user: [cmdUser, -1],
