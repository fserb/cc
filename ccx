// ccx new [host:]<dir> [name]
// The same spawn() as the page's +: a new tmux window after an instance already in `dir`,
// else a new kitty window, or a detached tmux session on a host with no kitty attached
async function cmdNew(dir, ...words) {
  if (!dir) usage();
  const name = words.join(" ");
  const colon = dir.indexOf(":");
  const host = colon > 0 ? dir.slice(0, colon) : "";
  if (host && HOSTS.includes(host) && host !== SELF) {
    // the remote's own ~ and realpath; a relative dir would mean ours
    const rest = dir.slice(colon + 1);
    if (!rest.startsWith("/") && !rest.startsWith("~")) {
      console.error(`new: ${host}: give an absolute or ~ path, not ${JSON.stringify(rest)}`);
      Deno.exit(1);
    }
    // spawn() waits up to 5s for a window and 10s for claude
    const [r, err] = await call(host, "/api/spawn", {dir: rest, name, beside: true}, 20000);
    if (err) {
      console.error(`new: ${host}: ${err}`);
      Deno.exit(1);
    }
    console.log(r.existing ? `${host}:${r.pid} already running in ${host}:${rest}`
      : `started ${host}:${r.pid} in ${host}:${rest}, ` +
        (r.after ? `tmux window after ${r.after}` : `tmux pane ${r.pane}`));
    return;
  }
  let path = expandDir(dir);
  if (!path.startsWith("/")) path = `${CWD}/${path}`;
  try {
    path = Deno.realPathSync(path);
  } catch {
    // spawn() names the missing directory
  }
  const after = await paneIn(path);
  const r = await spawn({dir: path, after, name});
  if (r.error) {
    console.error(`new: ${r.error}`);
    Deno.exit(1);
  }
  console.log(r.existing ? `${r.pid} already running in ${path.replace(HOME, "~")}`
    : `started ${r.pid} in ${path.replace(HOME, "~")}, ` +
      (after ? `tmux window after ${after}` : "new kitty window"));
}

// ccx delete [host:]<name|pid>
// An exact name or pid, never the fuzzy match `send` takes, and one instance only: a typo
// that happens to match some other session would kill that one
async function cmdDelete(spec) {
  const [host, want] = splitHost(spec);
  const {instances, down} = host ? await discoverAll(new StateClock())
    : {instances: await discover(), down: []};
  reportDown(down);
  const needle = want.toLowerCase();
  const hits = instances.filter((i) => i.host === host &&
    (String(i.pid) === want || i.name.toLowerCase() === needle));
  if (hits.length !== 1) {
    console.error(hits.length
      ? `delete: ${JSON.stringify(spec)} names ${hits.length}: ${hits.map(label).join(", ")}`
      : `delete: no instance is named ${JSON.stringify(spec)}`);
    Deno.exit(1);
  }
  const i = hits[0];
  report("closed", hits, [], [i.host
    ? (await call(i.host, `/api/s/${i.pid}/close`, {}, 10000))[1] : await close(i)]);
}

// `host:rest` naming another host, as ["host", "rest"]; anything else is ours, ["", spec]
function splitHost(spec) {
  const colon = spec.indexOf(":");
  const host = colon > 0 ? spec.slice(0, colon) : "";
  if (!HOSTS.includes(host)) return ["", spec];
  return [host === SELF ? "" : host, spec.slice(colon + 1)];
}

// ccx serve [--port N]
// The HTTP server alone on 127.0.0.1, with its own poll; `ccx host` is the same on the
// tailnet, plus the relay.
async function cmdServe(...args) {
  let port;
  for (let n = 0; n < args.length; n++) {
    if (args[n] !== "--port" || !/^\d+$/.test(args[n + 1] ?? "")) usage();
    port = Number(args[++n]);
  }
  let mod;
  try {
    mod = await serverModule();
  } catch (e) {
    console.error(`serve: ${e.message ?? e}`);
    Deno.exit(1);
  }
  const clock = new StateClock(), net = new Online();
  let instances = [], polling = false;
  const poll = async () => {
    net.tick();
    if (polling) return;
    polling = true;
    try {
      instances = clock.update(await discover());
    } finally {
      polling = false;
    }
  };
  await poll();
  setInterval(poll, 1500);
  port ??= mod.PORT;
  const r = mod.runServer({source: () => ({instances, net}), port});
  if (r.error) {
    console.error(`serve: ${r.error}`);
    Deno.exit(1);
  }
  console.log(`ccx serve on http://127.0.0.1:${port}/`);
  await new Promise(() => {});
}

// ccx host [--port N]
// The daemon each machine runs: the server on every interface, tailnet and loopback only,
// and a stand-in record for every claude on the other hosts so SendMessage reaches them
async function cmdHost(...args) {
  let port;
  for (let n = 0; n < args.length; n++) {
    if (args[n] !== "--port" || !/^\d+$/.test(args[n + 1] ?? "")) usage();
    port = Number(args[++n]);
  }
  const [srv, relayMod, remote, {Subs}, {sendPeer}] = await Promise.all([serverModule(),
    import("./relay.js"), import("./remote.js"), import("./subs.js"), peerModule()]);
  port ??= srv.PORT;
  const clock = new StateClock(remote.SELF), net = new Online();
  // A poll runs when a session record is written, and otherwise once a minute for titles
  // and tmux moves, which no record shows. A write during a poll runs one more after it.
  // With no watch, or an instance with no record (its state is read off the pane), every
  // 1.5s as before
  let instances = [], polling = false, again = false, timer = 0, server = null;
  const poll = async () => {
    if (polling) {
      again = true;
      return;
    }
    polling = true;
    try {
      do {
        again = false;
        instances = clock.update(await discover());
      } while (again);
      server?.pushList();
    } finally {
      polling = false;
      clearTimeout(timer);
      timer = setTimeout(repoll, !watching || instances.some((i) => !i.peer) ? 1500 : 60000);
    }
  };
  const repoll = () => poll().catch((e) => console.error(e));
  const watching = watchSessions(repoll);
  setInterval(() => net.tick(), 5000);
  net.tick();
  // a notice goes to a local subscriber's socket, or to its host's daemon. The listener runs
  // inside clock.update(), so `instances` is still the poll before, which is fine: a
  // subscriber had to exist to subscribe
  const subs = new Subs(remote.SELF, async (who, text) => {
    if (who.host !== remote.SELF) {
      return (await remote.call(who.host, `/api/s/${who.pid}/send`, {text, from: "ccx"}))[1];
    }
    const inst = instances.find((i) => i.pid === who.pid);
    return inst ? await sendPeer(inst, text, "ccx") : `no claude instance with pid ${who.pid}`;
  });
  clock.on((events) => subs.onEvents(events));
  await poll();
  relayMod.clearStandIns(remote.SELF);
  const relay = new relayMod.Relay(remote.SELF, async (host, body) =>
    (await remote.call(host, "/api/relay", body))[1]);
  const r = srv.runServer({source: () => ({instances, net}), port, hostname: "0.0.0.0", relay,
    subs});
  if (r.error) {
    console.error(`host: ${r.error}`);
    Deno.exit(1);
  }
  server = r.server;
  const stops = remote.others().map((h) => remote.follow(h, (rows) => relay.sync(h, rows)));
  const quit = () => {
    for (const stop of stops) stop();
    relay.close();
    Deno.exit(0);
  };
  Deno.addSignalListener("SIGINT", quit);
  Deno.addSignalListener("SIGTERM", quit);
  console.log(`ccx host ${remote.SELF} on :${port}, following ${remote.others().join(", ") ||
    "no other host"}`);
  await new Promise(() => {});
}

// targets

// The instance we are running inside, or 0 outside one. Claude Code puts CLAUDE_PID in the
// environment of every shell it spawns (2.1.273, read off a live one), so `all` can leave
// us out for the price of an env read rather than a walk up the ppid chain.
function selfPid() {
  const pid = Number(Deno.env.get("CLAUDE_PID") ?? 0);
  return Number.isInteger(pid) && pid > 0 ? pid : 0;
}

/* One target: `all`, a pid, a name, or a fuzzy match on the name or the path.
 *
 * Exact beats fuzzy, so a session actually named `ccx` is not outranked by another whose
 * path merely holds those three letters. Matching more than one instance is the point of
 * the feature and not an error; matching none is the only error resolution has.
 */
function resolveTarget(instances, target, self = 0) {
  if (!target) return [];
  // `host:target` is target among that host's instances only
  const colon = target.indexOf(":");
  if (colon > 0 && HOSTS.includes(target.slice(0, colon))) {
    const host = target.slice(0, colon) === SELF ? "" : target.slice(0, colon);
    // a bare pid below means a local one, and a pid here is that host's
    const pid = target.slice(colon + 1);
    if (/^\d+$/.test(pid)) return instances.filter((i) => i.host === host && i.pid === Number(pid));
    return resolveTarget(instances.filter((i) => i.host === host), target.slice(colon + 1),
      self);
  }
  if (target === "all") return instances.filter((i) => i.host || i.pid !== self);
  if (/^\d+$/.test(target)) return instances.filter((i) => !i.host && i.pid === Number(target));
  const needle = target.toLowerCase();
  const named = instances.filter((i) => i.name.toLowerCase() === needle);
  if (named.length) return named;
  const scored = [];
  for (const i of instances) {
    const hits = [fuzzy(needle, i.name), fuzzy(needle, i.shortPath)].filter((h) => h);
    if (hits.length) scored.push([Math.min(...hits.map((h) => h.score)), i]);
  }
  return scored.sort((a, b) => a[0] - b[0] || a[1].pid - b[1].pid).map((p) => p[1]);
}

// Every target's matches, in the order the targets were written and each instance once: two
// targets that name the same session send it one message, not two.
function resolveTargets(instances, spec, self = 0) {
  const found = [], missed = [], seen = new Set();
  for (const t of spec.split(",").map((s) => s.trim()).filter((s) => s)) {
    const hits = resolveTarget(instances, t, self);
    if (!hits.length) missed.push(t);
    for (const i of hits) {
      if (seen.has(label(i))) continue;
      seen.add(label(i));
      found.push(i);
    }
  }
  return {found, missed};
}

// `ccx list`'s shape: what happened, who to, where, and the detail. String.padEnd and not
// display cells, like cmdList: a listing that is piped is columns, not a frame
const sendLine = (verb, who, where, what) =>
  `${verb.padEnd(6)} ${who.padEnd(12)} ${where.padEnd(30)} ${what}`;

// Validate, then resolve. In that order: a target is resolved against live state, so text
// that is not there has to be caught first or `ccx send ccx-ef` goes looking for ccx-ef.
// Exits on usage; returns what `spec` named and what it did not
async function targets(cmd, spec, text) {
  if (!spec || !text.trim()) usage();
  const {instances, down} = await discoverAll(new StateClock());
  reportDown(down);
  const {found, missed} = resolveTargets(instances, spec, selfPid());
  if (!found.length) {
    for (const t of missed) console.error(`${cmd}: no instance matches ${JSON.stringify(t)}`);
    usage();
  }
  return {found, missed};
}

// One line per target in the order written, and exit 1 if any of them failed. The errs are
// awaited together: one target can fail while the others land, and a listing that arrives
// in completion order is unreadable
function report(verb, found, missed, errs) {
  for (const t of missed) console.log(sendLine("failed", t, "-", "no instance matches"));
  found.forEach((i, n) => console.log(errs[n]
    ? sendLine("failed", label(i), i.shortPath, errs[n])
    : sendLine(verb, label(i), i.shortPath, i.summary)));
  if (missed.length || errs.some((e) => e)) Deno.exit(1);
}

// a send or type on the host the instance runs on, by its api. An error, or null
async function onHost(i, verb, text) {
  return (await call(i.host, `/api/s/${i.pid}/${verb}`, {text}))[1];
}

// ccx send <target>[,<target>...] <message...>
async function cmdSend(spec, ...words) {
  const text = words.join(" ");
  const {found, missed} = await targets("send", spec, text);
  let sendPeer;
  try {
    ({sendPeer} = await peerModule());
  } catch (e) {
    console.error(`send: ${e.message ?? e}`);
    Deno.exit(1);
  }
  report("sent", found, missed, await Promise.all(found.map((i) =>
    i.host ? onHost(i, "send", text) : sendPeer(i, text))));
}

// ccx user <target>[,<target>...] <text...>
// Typed into the instance's prompt as its own user and submitted, so `/clear` clears it;
// `send` puts a message from a peer on its queue, which no slash command survives
async function cmdUser(spec, ...words) {
  const text = words.join(" ");
  const {found, missed} = await targets("user", spec, text);
  report("typed", found, missed, await Promise.all(found.map((i) =>
    i.host ? onHost(i, "type", text) : typeInto(i, text))));
}

// ccx chat [--no-follow]
async function cmdChat(...args) {
  let follow = true;
  for (const a of args) {
    if (a !== "--no-follow") usage();
    follow = false;
  }
  let mod;
  try {
    mod = await chatModule();
  } catch (e) {
    console.error(`chat: ${e.message ?? e}`);
    Deno.exit(1);
  }
  // colour only into a terminal, so a pipe carries the words and nothing else
  const colour = Deno.stdout.isTerminal();
  const width = Math.max(20, size().cols - 1);
  const show = (m) => {
    for (const runs of chatLines(m, width, Date.now() / 1000)) {
      console.log(colour ? paint(runs, null) : runs.map((r) => r.t).join("").trimEnd());
    }
    console.log("");
  };
  for (const m of mod.chatLog(CWD)) show(m);
  if (!follow) return;
  mod.watchChat(CWD, show);
  await new Promise(() => {});       // ctrl+c is the way out, the same as `tail -f`
}

// Exactly one instance for `spec`, `me` being the one we run inside; exits otherwise
function onlyOne(cmd, instances, spec) {
  const self = selfPid();
  const hits = spec === "me" ? instances.filter((i) => !i.host && i.pid === self)
    : resolveTarget(instances, spec, self);
  if (hits.length === 1) return hits[0];
  console.error(spec === "me" && !self ? `${cmd}: "me" only means something inside a claude`
    : hits.length ? `${cmd}: ${JSON.stringify(spec)} is ${hits.map(label).join(", ")}; name one`
    : `${cmd}: no instance matches ${JSON.stringify(spec)}`);
  Deno.exit(1);
}

const where = (i) => `${i.host || SELF}:${i.name || i.pid}`;

// ccx notify <who> when <agent> [is <state>] [for <duration>]
// Registered with the daemon of the host <agent> runs on, which messages <who> from `ccx`
async function cmdNotify(...words) {
  const {parseNotify} = await import("./subs.js");
  const n = parseNotify(words);
  if (n.error) {
    console.error(`notify: ${n.error}`);
    Deno.exit(2);
  }
  const {instances, down} = await discoverAll(new StateClock());
  reportDown(down);
  const who = onlyOne("notify", instances, n.who);
  const target = onlyOne("notify", instances, n.target);
  const host = target.host || SELF;
  const [r, err] = await call(host, "/api/subs", {pid: target.pid, state: n.state,
    secs: n.secs, who: {host: who.host || SELF, pid: who.pid, name: who.name}});
  if (err) {
    console.error(`notify: ${err}`);
    Deno.exit(1);
  }
  const what = n.state ? `is ${n.state}` : "changes state";
  const until = n.secs ? `, every time for ${words.at(-1)}` : ", once";
  const now = n.state && r.state === n.state ? `; it is ${r.state} already, so the next time`
    : `; now ${r.state}`;
  console.log(`${host}:${r.id}: tell ${where(who)} when ${where(target)} ${what}${until}${now}`);
}

// ccx subs: every host's subscriptions
async function cmdSubs() {
  const all = await Promise.all(HOSTS.map((h) => call(h, "/api/subs")));
  HOSTS.forEach((h, n) => {
    const [body, err] = all[n];
    if (err) return console.error(`${h}: down, ${err}`);
    for (const s of body.subs) {
      const until = s.until ? `until ${new Date(s.until * 1000).toLocaleTimeString()}` : "once";
      console.log(`${`${h}:${s.id}`.padEnd(10)} ${`${s.who.host}:${s.who.name || s.who.pid}`
        .padEnd(18)} <- ${`${h}:${s.target.name || s.target.pid}`.padEnd(18)} ` +
        `${(s.state || "any").padEnd(5)} ${until}`);
    }
  });
}

// ccx unsub [host:]<id>, this host's id without one
async function cmdUnsub(spec) {
  const m = /^(?:([^:]+):)?(\d+)$/.exec(spec);
  if (!m || (m[1] && !HOSTS.includes(m[1]))) usage();
  const [, err] = await call(m[1] ?? SELF, "/api/unsub", {id: Number(m[2])});
  if (err) {
    console.error(`unsub: ${err}`);
    Deno.exit(1);
  }
}

const COMMANDS = {
  ps: [cmdUi, 0],
  list: [cmdList, 0],
  usage: [cmdUsage, 0],
  doctor: [cmdDoctor, 0],
  focus: [cmdFocus, 1],
  new: [cmdNew, -1],
  delete: [cmdDelete, 1],
  send: [cmdSend, -1],               // -1: its own validation, since the message is the rest
  user: [cmdUser, -1],
  chat: [cmdChat, -1],
  notify: [cmdNotify, -1],
  subs: [cmdSubs, 0],
  unsub: [cmdUnsub, 1],
  serve: [cmdServe, -1],
  host: [cmdHost, -1],
  help: [cmdHelp, 0],
  "-h": [cmdHelp, 0],
  "--help": [cmdHelp, 0],
  "--snapshot": [cmdSnapshot, -1],
  "--resolve": [cmdResolve, -1],
};

// one help line each: a [syntax, what it does] pair is drawn as a column, a string as it
// is, and an empty syntax continues the line above. --snapshot and --resolve are left out
// of it, they exist for the tests
const HELP = [
  "usage: ccx <command> [args]",
  "",
  ["  ps", "the listing as a TUI, and enter to jump to an instance"],
  ["  list", "the same listing, one line each, no UI"],
  ["  usage", "the seven-day limit, the last 6h against what is left, the week by day"],
  ["  doctor", "what resolves, and the kitty match it would use"],
  ["  focus <target>", "jump to one instance without the UI, on any host"],
  ["  new [host:]<dir> [name...]", "a claude in dir: beside one already there, else a kitty window; none if name is there"],
  ["  delete [host:]<name|pid>", "end one instance and close its tmux pane"],
  ["  send <target> <message...>", "a chat message to one or more instances"],
  ["  user <target> <text...>", "typed into an instance as its user, /commands included"],
  ["  chat [--no-follow]", "what the agents here have said to each other"],
  ["  notify <who> when <target>", "message who (`me` inside a claude) from `ccx` when target's"],
  ["  [is <state>] [for <time>]", "state changes, or goes to wait|busy|hold|free|gone; once,"],
  ["", "or every time for 30m, 2h, 1d. Lives in target's host daemon"],
  ["  subs", "every host's subscriptions"],
  ["  unsub <host:id>", "drop one"],
  ["  serve [--port N]", "the web page and its API on 127.0.0.1, port 7681"],
  ["  host [--port N]", "the daemon: serve on the tailnet, and relay SendMessage between hosts"],
  ["  help", "this, which is also what `ccx` alone prints"],
  "",
  ["  <target>", "a pid, a session name, `all`, or part of either; `host:` before it"],
  ["", "picks that host's instances only"],
  ["", "`send` and `user` take a comma-separated list of them"],
];

// colour only into a terminal, so a pipe carries the words and nothing else. paint() ends
// on a RESET, which is what leaves the description in the terminal's own colour
function helpText(colour) {
  const pad = Math.max(...HELP.filter(Array.isArray).map(([k]) => k.length)) + 2;
  return HELP.map((line) => {
    if (!Array.isArray(line)) return line;
    const [key, what] = line;
    const gap = " ".repeat(pad - key.length);
    return (colour ? paint([{t: key, c: PALETTE.accent, b: true}], null) : key) + gap +
      what;
  }).join("\n");
}

// `ccx help` is stdout and 0; a bad argument list is the same text on stderr and 2, and
// the tests read its first line, so `usage: ccx` has to stay the start of it
function cmdHelp() {
  console.log(helpText(Deno.stdout.isTerminal()));
}

function usage() {
  console.error(helpText(Deno.stderr.isTerminal()));
  Deno.exit(2);
}

const [name = "help", ...rest] = Deno.args;
const cmd = COMMANDS[name];
if (!cmd || (cmd[1] >= 0 && rest.length !== cmd[1])) usage();
await cmd[0](...rest);
// an open follow() stream or a probe timer would otherwise keep the process alive
Deno.exit(0);
