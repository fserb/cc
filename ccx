// ccx --snapshot [chat] [<cols>x<rows>] [plain] [/<filter>] [empty] [toast] [cursor=N]
//                 [offset=N] [usage=<used>@<hours into the week>]
// cursor= and offset= reach the cursor row's fill and a scrolled table; both are colour,
// so `plain` throws away what you came for. `chat` draws the chat view against CHAT_SAMPLE
// and an `at` fixed against NOW, since a relative age off the clock is not reproducible
function cmdSnapshot(...args) {
  let cols = 100, height = 14, plain = false, filter = "", rows = sample(), toast = null;
  let cursor = 0, offset = 0, chat = false, offline = "", use = null;
  for (const a of args) {
    const wh = /^(\d+)x(\d+)$/.exec(a);
    const nm = /^(cursor|offset)=(\d+)$/.exec(a);
    const us = /^usage=([\d.]+)@([\d.]+)$/.exec(a);
    if (wh) [cols, height] = [Number(wh[1]), Number(wh[2])];
    else if (us) {
      // reset times print in local time, so the frame is only fixed under a fixed TZ
      const now = NOW * 1000, left = (168 - Number(us[2])) * 3600_000;
      use = usageLine({used: Number(us[1]), resetsAt: now + left, at: now}, now);
    }
    else if (nm) (nm[1] === "cursor" ? cursor = Number(nm[2]) : offset = Number(nm[2]));
    else if (a === "plain") plain = true;
    else if (a === "chat") chat = true;
    else if (a === "empty") rows = [];
    else if (a === "offline") offline = "offline";
    else if (a === "toast") toast = "pid 1000 is not inside tmux; nothing to focus";
    else if (a.startsWith("/")) filter = a.slice(1);
    else return usage();
  }
  const needle = filter.trim().toLowerCase();
  const ranked = rank(rows, needle, SORTS[0]);
  const frame = (chat
    ? chatRender({cwd: "~/ai/ccx", msgs: rows.length ? CHAT_SAMPLE : [], offset, toast,
      cols, height, now: NOW})
    : render({
      ranked, total: rows.length, waiting: rows.filter((i) => i.state === "wait").length,
      filter, needle, sort: SORTS[0], offline, usage: use, cursor, offset, toast, cols, height,
    })).join("\n");
  console.log(plain ? frame.replaceAll(SGR, "") : frame);
}

// ccx --resolve <target>[,<target>...] [self=N]
// The resolver against --snapshot's fixed rows. `--ext js` covers the entry module only, so
// ccx_test.js cannot import this file; a subprocess is how the frame is tested too
function cmdResolve(...args) {
  let spec = "", self = 0;
  for (const a of args) {
    const s = /^self=(\d+)$/.exec(a);
    if (s) self = Number(s[1]);
    else if (!spec) spec = a;
    else return usage();
  }
  if (!spec) usage();
  const {found, missed} = resolveTargets(sample(), spec, self);
  for (const t of missed) console.log(`miss ${t}`);
  for (const i of found) console.log(`${i.pid} ${i.name} ${i.shortPath}`);
}

