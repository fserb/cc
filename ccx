// ccx focus <target>, one instance on any host
async function cmdFocus(spec) {
  const {instances, down} = await discoverAll(new StateClock());
  reportDown(down);
  const hits = resolveTarget(instances, spec, 0);
  if (hits.length !== 1) {
    console.error(hits.length ? `focus: ${JSON.stringify(spec)} names ${hits.length}: ` +
      hits.map(label).join(", ") : `focus: no instance matches ${JSON.stringify(spec)}`);
    Deno.exit(1);
  }
  const err = await (hits[0].host ? jumpRemote(hits[0]) : jump(hits[0]));
  if (!err) return;
  console.error(err);
